---
import { navigation } from "../../data/navigation";
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-[#050505]/92 backdrop-blur-xl">
  <div class="mx-auto w-full max-w-[1440px] px-5 sm:px-7 lg:px-10">
    <div class="flex h-[78px] items-center justify-between gap-6">
      <a href="/" class="flex min-w-0 items-center gap-3.5" aria-label="Ir al inicio de ForenseIA">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden border border-[#C8A96B]/35 bg-black">
          <img src="/logo.png" alt="" width="44" height="44" class="h-full w-full object-contain p-1" />
        </span>
        <span class="min-w-0 leading-none">
          <span class="block truncate text-sm font-bold tracking-[0.16em] text-white">FORENSEIA</span>
          <span class="mt-2 block truncate text-[8px] font-semibold uppercase tracking-[0.28em] text-[#C8A96B]">Inteligencia estratégica</span>
        </span>
      </a>

      <nav class="hidden items-center gap-7 xl:flex" aria-label="Navegación principal">
        {navigation.map((item) => (
          <a href={item.href} class="text-[13px] font-medium text-white/62 transition hover:text-white">{item.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href="/contacto" class="hidden min-h-11 items-center border border-[#C8A96B]/55 px-5 text-xs font-semibold text-[#E4CB96] transition hover:bg-[#C8A96B] hover:text-black md:inline-flex">
          Solicitar diagnóstico
        </a>
        <button id="menu-button" type="button" class="inline-flex h-11 w-11 items-center justify-center border border-white/12 text-xl text-white xl:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
          <span aria-hidden="true">☰</span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-[#050505] xl:hidden">
    <div class="mx-auto max-w-[1440px] px-5 py-6 sm:px-7">
      <nav class="grid gap-1" aria-label="Navegación móvil">
        {navigation.map((item) => (
          <a href={item.href} class="border-b border-white/8 py-3 text-sm text-white/70 transition hover:text-[#C8A96B]">{item.label}</a>
        ))}
        <a href="/contacto" class="mt-4 flex min-h-12 items-center justify-center border border-[#C8A96B]/60 text-sm font-semibold text-[#E4CB96]">Solicitar diagnóstico</a>
      </nav>
    </div>
  </div>
</header>
<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");
  button?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    button.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
