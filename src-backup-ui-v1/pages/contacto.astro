---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import { CONTACT } from "../constants/contact";
---

<BaseLayout title="Contacto | ForenseIA">
  <PageHeader
    eyebrow="Contacto"
    title="Hablemos de tu caso o capacitación."
    description="Solicita diagnóstico, curso, consultoría o colaboración."
  />

  <section class="py-20">
    <Container>
      <div class="grid lg:grid-cols-[1fr_380px] gap-8">
        <form
          name="contacto"
          method="POST"
          data-netlify="true"
          class="border border-white/10 bg-white/[0.03] p-8 space-y-5"
        >
          <input type="hidden" name="form-name" value="contacto" />

          <input
            name="nombre"
            required
            placeholder="Nombre"
            class="w-full bg-black border border-white/10 px-4 py-4 text-white outline-none focus:border-[#C8A96B]"
          />

          <input
            name="correo"
            type="email"
            required
            placeholder="Correo"
            class="w-full bg-black border border-white/10 px-4 py-4 text-white outline-none focus:border-[#C8A96B]"
          />

          <input
            name="telefono"
            placeholder="WhatsApp"
            class="w-full bg-black border border-white/10 px-4 py-4 text-white outline-none focus:border-[#C8A96B]"
          />

          <select
            name="tipo"
            class="w-full bg-black border border-white/10 px-4 py-4 text-white outline-none focus:border-[#C8A96B]"
          >
            <option>Diagnóstico</option>
            <option>Curso</option>
            <option>Consultoría</option>
            <option>Colaboración</option>
          </select>

          <textarea
            name="mensaje"
            required
            placeholder="Mensaje"
            class="w-full bg-black border border-white/10 px-4 py-4 text-white min-h-40 outline-none focus:border-[#C8A96B]"
          ></textarea>

          <button
            type="submit"
            class="bg-[#C8A96B] text-black px-8 py-4 font-medium hover:opacity-90 transition"
          >
            Enviar
          </button>
        </form>

        <aside class="border border-white/10 bg-white/[0.03] p-8 h-fit">
          <h2 class="text-2xl font-semibold">
            Contacto directo
          </h2>

          <div class="mt-6 space-y-4 text-white/55">
            <a href={CONTACT.whatsapp} target="_blank" class="block hover:text-[#C8A96B]">
              WhatsApp: +52 993 133 6447
            </a>

            <a href={`mailto:${CONTACT.email}`} class="block hover:text-[#C8A96B]">
              {CONTACT.email}
            </a>

            <a href={CONTACT.facebook} target="_blank" class="block hover:text-[#C8A96B]">
              Facebook
            </a>

            <a href={CONTACT.instagram} target="_blank" class="block hover:text-[#C8A96B]">
              Instagram
            </a>

            <a href={CONTACT.tiktok} target="_blank" class="block hover:text-[#C8A96B]">
              TikTok
            </a>
          </div>
        </aside>
      </div>
    </Container>
  </section>
</BaseLayout>