---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => post.data.status === "published")
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
  );

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const categories = [
  ...new Set(posts.map((post) => post.data.category)),
];

function formatDate(date: Date | string) {
  return new Intl.DateTimeFormat("es-MX", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(date));
}
---

<BaseLayout
  title="Biblioteca | ForenseIA"
  description="Artículos, análisis y guías sobre inteligencia artificial, investigación digital, ciberseguridad y psicología criminal."
>
  <section class="border-b border-white/10 pt-40 pb-20">
    <Container>
      <div class="grid items-end gap-12 lg:grid-cols-[0.75fr_1.25fr]">
        <div>
          <p class="text-xs uppercase tracking-[0.35em] text-[#C8A96B]">
            Biblioteca ForenseIA
          </p>

          <h1 class="mt-6 text-5xl font-semibold leading-[0.96] tracking-[-0.05em] md:text-7xl">
            Conocimiento para decisiones complejas.
          </h1>
        </div>

        <p class="max-w-2xl text-lg leading-relaxed text-white/50">
          Artículos, análisis, guías y casos sobre inteligencia artificial,
          OSINT, ciberseguridad, investigación digital y psicología criminal.
        </p>
      </div>
    </Container>
  </section>

  <section class="py-12">
    <Container>
      <div class="flex flex-wrap gap-3">
        <span
          class="border border-[#C8A96B]/60 px-4 py-2 text-sm text-[#C8A96B]"
        >
          Todos
        </span>

        {categories.map((category) => (
          <span
            class="border border-white/10 px-4 py-2 text-sm text-white/45"
          >
            {category}
          </span>
        ))}
      </div>
    </Container>
  </section>

  {featuredPost ? (
    <section class="pb-20">
      <Container>
        <article
          class="group grid overflow-hidden border border-white/10 bg-white/[0.02] lg:grid-cols-[1.15fr_0.85fr]"
        >
          <div class="relative min-h-[360px] overflow-hidden bg-black">
            {featuredPost.data.cover ? (
              <img
                src={featuredPost.data.cover}
                alt={featuredPost.data.title}
                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
            ) : (
              <div
                class="flex h-full min-h-[360px] items-center justify-center bg-[radial-gradient(circle_at_center,rgba(200,169,107,0.14),transparent_55%)]"
              >
                <img
                  src="/logo.png"
                  alt="ForenseIA"
                  class="w-40 opacity-80"
                />
              </div>
            )}
          </div>

          <div class="flex flex-col justify-center p-8 md:p-12">
            <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
              Artículo destacado
            </p>

            <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm text-white/35">
              <span>{featuredPost.data.category}</span>
              <span>{featuredPost.data.author}</span>
              <span>{formatDate(featuredPost.data.date)}</span>
            </div>

            <h2 class="mt-5 text-3xl font-semibold leading-tight md:text-5xl">
              {featuredPost.data.title}
            </h2>

            <p class="mt-6 leading-relaxed text-white/50">
              {featuredPost.data.description}
            </p>

            <div class="mt-8">
              <Button href={`/blog/${featuredPost.id}`}>
                Leer artículo
              </Button>
            </div>
          </div>
        </article>
      </Container>
    </section>
  ) : null}

  <section class="border-t border-white/10 bg-white/[0.02] py-20">
    <Container>
      <div class="mb-12 flex items-end justify-between gap-8">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
            Publicaciones
          </p>

          <h2 class="mt-5 text-4xl font-semibold md:text-5xl">
            Últimos artículos
          </h2>
        </div>

        <p class="hidden text-sm text-white/35 md:block">
          {posts.length} publicaciones
        </p>
      </div>

      {posts.length === 0 ? (
        <div class="border border-white/10 bg-black/30 p-10">
          <p class="text-white/50">
            Todavía no hay publicaciones disponibles.
          </p>
        </div>
      ) : remainingPosts.length === 0 ? (
        <div class="border border-white/10 bg-black/30 p-8">
          <p class="text-white/50">
            El artículo más reciente aparece como publicación destacada.
          </p>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {remainingPosts.map((post) => (
            <article
              class="group flex h-full flex-col overflow-hidden border border-white/10 bg-black/40 transition duration-300 hover:-translate-y-1 hover:border-[#C8A96B]/50"
            >
              <div class="relative aspect-[16/9] overflow-hidden border-b border-white/10">
                {post.data.cover ? (
                  <img
                    src={post.data.cover}
                    alt={post.data.title}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
                  />
                ) : (
                  <div
                    class="flex h-full items-center justify-center bg-[radial-gradient(circle_at_center,rgba(200,169,107,0.10),transparent_60%)]"
                  >
                    <img
                      src="/logo.png"
                      alt="ForenseIA"
                      class="w-20 opacity-60"
                    />
                  </div>
                )}
              </div>

              <div class="flex flex-1 flex-col p-7">
                <p class="text-xs uppercase tracking-[0.25em] text-[#C8A96B]">
                  {post.data.category}
                </p>

                <h3 class="mt-5 text-2xl font-semibold leading-tight">
                  {post.data.title}
                </h3>

                <p class="mt-4 flex-1 leading-relaxed text-white/45">
                  {post.data.description}
                </p>

                <div class="mt-7 flex flex-wrap gap-x-3 gap-y-2 text-xs text-white/30">
                  <span>{post.data.author}</span>
                  <span>{formatDate(post.data.date)}</span>
                </div>

                <a
                  href={`/blog/${post.id}`}
                  class="mt-7 text-sm text-[#C8A96B]"
                >
                  Leer artículo →
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </Container>
  </section>
</BaseLayout>