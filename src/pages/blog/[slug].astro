---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import "../../styles/blog-v4.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.filter((entry) => {
    const data = entry.data as Record<string, any>;
    return data.status !== "draft" && data.draft !== true;
  }).map((post) => ({ params: { slug: String(post.id) }, props: { post } }));
}

const { post } = Astro.props;
const data = post.data as Record<string, any>;
const { Content, headings } = await render(post);
const value = data.cover ?? data.image ?? data.featuredImage;
const cover = (typeof value === "string" ? value.trim() : value?.src ?? "") || "/images/blog/centro-operaciones-forenseia.jpg";
const description = data.description ?? data.excerpt ?? "Contenido especializado de ForenseIA.";
const category = data.category ?? data.area ?? "Blog";
const author = data.author ?? data.director ?? "Equipo ForenseIA";
const date = new Date(String(data.date ?? ""));
const formattedDate = Number.isNaN(date.getTime()) ? "" : new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" }).format(date);
const readingMinutes = Math.max(2, Math.ceil(String(post.body ?? "").split(/\s+/).filter(Boolean).length / 210));
const tags = Array.isArray(data.tags) ? data.tags.map(String) : [category];
---

<BaseLayout title={`${data.title} | Blog ForenseIA`} description={description} image={cover || undefined}>
  <main class="article-v3">
    <header class="article-v3__header">
      <div class="article-v3__shell">
        <nav class="article-v3__breadcrumb"><a href="/">Inicio</a><span>›</span><a href="/blog">Blog</a><span>›</span><span>{category}</span></nav>
        <div class="article-v3__head-grid">
          <div class="article-v3__head-copy">
            <span class="blog-v3__eyebrow">{data.featured ? "Artículo destacado" : category}</span>
            <h1>{data.title}</h1>
            <p>{description}</p>
            <div class="article-v3__meta"><span>{author}</span><time>{formattedDate}</time><span>{readingMinutes} min de lectura</span></div>
          </div>
          <aside class="article-v3__author-card">
            <span class="blog-v3__eyebrow">Sobre el autor</span>
            <div class="article-v3__avatar">{String(author).charAt(0)}</div>
            <h2>{author}</h2>
            <p>{data.authorRole ?? data.role ?? "Especialista y colaborador de ForenseIA."}</p>
          </aside>
        </div>
        <figure class="article-v3__cover">
          <div class="blog-v3__image-fallback"><strong>F</strong><small>FORENSEIA</small></div>
          {cover && <img src={cover} alt={data.coverAlt ?? data.title} loading="eager" onerror="this.remove()" />}
        </figure>
        <div class="article-v4__visual-grid" aria-label="Galería editorial del artículo">
          <figure><img src="/images/blog/red-inteligencia-patrimonial.jpg" alt="Análisis de relaciones patrimoniales" loading="lazy" /><figcaption>Relaciones y vínculos</figcaption></figure>
          <figure><img src="/images/blog/auditoria-forense-documental.jpg" alt="Auditoría y revisión documental" loading="lazy" /><figcaption>Evidencia documental</figcaption></figure>
          <figure><img src="/images/blog/flujo-investigacion-digital.jpg" alt="Flujo de investigación digital" loading="lazy" /><figcaption>Flujo analítico</figcaption></figure>
        </div>
      </div>
    </header>

    <section class="article-v3__body-section">
      <div class="article-v3__shell article-v3__body-grid">
        <article class="article-v3__prose"><Content /></article>
        <aside class="article-v3__rail">
          {headings?.length > 1 && <section class="article-v3__rail-card"><h3>Índice del artículo</h3><ol>{headings.filter((h:any) => h.depth <= 3).map((h:any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></section>}
          <section class="article-v3__rail-card"><h3>Etiquetas</h3><div class="article-v3__tags">{tags.map((tag:string) => <span>{tag}</span>)}</div></section>
          <section class="article-v3__rail-card article-v4__magazine-card"><img src="/images/blog/gaceta-forenseia-julio-2026.jpg" alt="Portada Gaceta ForenseIA julio 2026" loading="lazy" /><h3>Edición visual</h3><p>La Gaceta es contenido editorial dentro del Blog ForenseIA.</p></section>
          <section class="article-v3__rail-card"><h3>ForenseIA</h3><p>Capacitación, investigación y soluciones de inteligencia aplicada.</p><a href="/contacto">Solicitar información →</a></section>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
