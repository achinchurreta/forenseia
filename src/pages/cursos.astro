---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import ForenseIAImage from "../components/ui/ForenseIAImage.astro";
import { getCollection } from "astro:content";
import "../styles/forenseia-assets.css";
import "../styles/services-academy-pro.css";

const courses = (await getCollection("courses"))
  .filter((course) => course.data.status === "published")
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) {
      return Number(b.data.featured) - Number(a.data.featured);
    }

    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

const courseImages = [
  "/assets/forenseia/academy/academia-investigacion-digital-1200.webp",
  "/assets/forenseia/hero/hero-home-centro-operaciones-1200.webp",
  "/assets/forenseia/services/servicio-inteligencia-patrimonial-1200.webp",
];

const resolveCourseImage = (course, index) => {
  const value = `${course.data.title} ${course.data.area}`.toLowerCase();

  if (value.includes("patrimonial")) {
    return "/assets/forenseia/services/servicio-inteligencia-patrimonial-1200.webp";
  }

  if (value.includes("forense") || value.includes("auditor")) {
    return "/assets/forenseia/services/servicio-auditoria-forense-1200.webp";
  }

  return courseImages[index % courseImages.length];
};

const routes = [
  {
    number: "01",
    title: "OSINT e investigación digital",
    description: "Búsqueda avanzada, validación, análisis de vínculos y documentación.",
  },
  {
    number: "02",
    title: "Inteligencia artificial aplicada",
    description: "Análisis documental, automatización y generación de productos.",
  },
  {
    number: "03",
    title: "Inteligencia patrimonial",
    description: "Personas, empresas, activos, relaciones y evaluación de riesgo.",
  },
  {
    number: "04",
    title: "Formación institucional",
    description: "Programas adaptados a perfiles, objetivos y operaciones reales.",
  },
];

const methodology = [
  ["Fundamento", "Conceptos esenciales y marco metodológico."],
  ["Demostración", "Aplicación guiada con herramientas y casos."],
  ["Práctica", "Ejercicios individuales y colaborativos."],
  ["Producto", "Informe, matriz, mapa o entregable verificable."],
];
---

<BaseLayout
  title="Academia | ForenseIA"
  description="Formación especializada en OSINT, investigación digital, inteligencia artificial e inteligencia patrimonial."
>
  <main class="sap-page">
    <section class="sap-hero sap-hero--academy">
      <div class="sap-hero__backdrop">
        <img
          src="/assets/forenseia/academy/academia-investigacion-digital-1600.webp"
          alt=""
          loading="eager"
          decoding="async"
        />
      </div>

      <Container class="sap-hero__container">
        <div class="sap-hero__content">
          <p class="sap-eyebrow">Academia ForenseIA</p>
          <h1>Formación aplicada para investigadores, analistas e instituciones.</h1>
          <p class="sap-lead">
            Cursos y programas construidos alrededor de metodologías, ejercicios y
            productos que pueden trasladarse al trabajo profesional.
          </p>

          <div class="sap-actions">
            <Button href="#programas">Explorar programas</Button>
            <Button href="/contacto" variant="secondary">Capacitación institucional</Button>
          </div>
        </div>
      </Container>
    </section>

    <section class="sap-section">
      <Container>
        <header class="sap-section-heading">
          <div>
            <p class="sap-eyebrow">Rutas de especialización</p>
            <h2>Desarrolla capacidades en una progresión clara.</h2>
          </div>
          <p>
            La academia organiza el aprendizaje por áreas y niveles para evitar cursos
            aislados sin continuidad profesional.
          </p>
        </header>

        <div class="sap-route-grid">
          {routes.map((route) => (
            <article>
              <span>{route.number}</span>
              <h3>{route.title}</h3>
              <p>{route.description}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section id="programas" class="sap-section sap-section--soft">
      <Container>
        <header class="sap-section-heading">
          <div>
            <p class="sap-eyebrow">Programas disponibles</p>
            <h2>Cursos con contexto, práctica y entregables.</h2>
          </div>
          <p>
            Consulta duración, modalidad, nivel e instructor antes de solicitar
            información o una propuesta institucional.
          </p>
        </header>

        {courses.length === 0 ? (
          <div class="sap-empty">
            Próximamente publicaremos nuevos programas de formación.
          </div>
        ) : (
          <div class="sap-course-grid">
            {courses.map((course, index) => (
              <article class="sap-course-card">
                <a href={`/cursos/${course.id}`} class="sap-course-card__media">
                  <ForenseIAImage
                    src={resolveCourseImage(course, index)}
                    alt={`Portada del curso ${course.data.title}`}
                    watermark={true}
                  />
                  <span class="sap-level">{course.data.level}</span>
                </a>

                <div class="sap-course-card__body">
                  <div class="sap-card-meta">
                    <span>{course.data.area}</span>
                    {course.data.featured && <span>Destacado</span>}
                  </div>

                  <h3>
                    <a href={`/cursos/${course.id}`}>{course.data.title}</a>
                  </h3>

                  <p>{course.data.description}</p>

                  <dl class="sap-course-facts">
                    <div>
                      <dt>Duración</dt>
                      <dd>{course.data.duration}</dd>
                    </div>
                    <div>
                      <dt>Modalidad</dt>
                      <dd>{course.data.modality}</dd>
                    </div>
                    <div>
                      <dt>Instructor</dt>
                      <dd>{course.data.instructor}</dd>
                    </div>
                  </dl>

                  <a class="sap-card-link" href={`/cursos/${course.id}`}>
                    Ver programa <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </Container>
    </section>

    <section class="sap-section">
      <Container>
        <div class="sap-split sap-split--reverse">
          <ForenseIAImage
            src="/assets/forenseia/hero/hero-home-centro-operaciones-1600.webp"
            alt="Centro de análisis empleado como entorno de aprendizaje profesional."
            class="sap-split__media"
          />

          <div class="sap-split__content">
            <p class="sap-eyebrow">Metodología</p>
            <h2>Aprender haciendo, documentando y explicando.</h2>
            <p>
              Cada programa combina teoría esencial, demostraciones, ejercicios y un
              producto final que permite evaluar el aprendizaje.
            </p>

            <div class="sap-method-grid">
              {methodology.map(([title, description], index) => (
                <article>
                  <span>0{index + 1}</span>
                  <h3>{title}</h3>
                  <p>{description}</p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </section>

    <section class="sap-cta">
      <Container>
        <div class="sap-cta__panel">
          <div>
            <p class="sap-eyebrow">Capacitación institucional</p>
            <h2>Adapta temario, duración y ejercicios a tu equipo.</h2>
            <p>
              Podemos diseñar una ruta presencial, en línea o híbrida de acuerdo con
              funciones, nivel técnico y objetivos operativos.
            </p>
          </div>
          <Button href="/contacto">Solicitar propuesta</Button>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>
