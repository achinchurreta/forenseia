---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import { services } from "../data/services";

const groups = [
  {
    id: "ia",
    label: "Inteligencia Artificial",
    description:
      "Soluciones de IA, automatización y transformación digital para gobierno e instituciones.",
    services: services.filter(
      (service) => service.owner === "Gonzalo García"
    ),
  },
  {
    id: "investigacion",
    label: "Investigación Digital y Ciberseguridad",
    description:
      "Servicios para fiscalías, organizaciones de investigación y equipos técnicos.",
    services: services.filter(
      (service) => service.owner === "Augusto Chinchurreta"
    ),
  },
  {
    id: "psicologia",
    label: "Psicología Criminal y Educativa",
    description:
      "Análisis del comportamiento, prevención y capacitación para instituciones y organizaciones.",
    services: services.filter(
      (service) => service.owner === "Tania Pérez"
    ),
  },
];
---

<BaseLayout title="Servicios | ForenseIA">
  <PageHeader
    eyebrow="Servicios"
    title="Tres áreas especializadas."
    description="Tecnología, investigación digital y psicología aplicada para instituciones, organizaciones y profesionales."
  />

  <section class="py-20">
    <Container>
      <div class="space-y-20">
        {groups.map((group, groupIndex) => (
          <section id={group.id}>
            <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 mb-10">
              <div>
                <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
                  Área 0{groupIndex + 1}
                </p>

                <h2 class="mt-4 text-4xl md:text-5xl font-semibold">
                  {group.label}
                </h2>
              </div>

              <p class="text-white/50 leading-relaxed max-w-2xl">
                {group.description}
              </p>
            </div>

            <div class="grid gap-4">
              {group.services.map((service) => (
                <article class="border border-white/10 bg-white/[0.03] p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                  <div>
                    <p class="text-[#C8A96B] text-xs uppercase tracking-[0.25em]">
                      {service.area}
                    </p>

                    <h3 class="mt-3 text-2xl font-semibold">
                      {service.title}
                    </h3>

                    <p class="mt-3 max-w-2xl text-white/50 leading-relaxed">
                      {service.description}
                    </p>
                  </div>

                  <Button href={service.href} variant="secondary">
                    Ver servicio
                  </Button>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-24">
    <Container>
      <div class="max-w-3xl">
        <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
          Diagnóstico
        </p>

        <h2 class="mt-5 text-4xl md:text-5xl font-semibold">
          ¿No sabes qué servicio necesitas?
        </h2>

        <p class="mt-5 text-white/50 leading-relaxed">
          Cuéntanos el contexto y te ayudamos a definir el área, alcance y siguiente paso.
        </p>

        <div class="mt-8">
          <Button href="/contacto">
            Solicitar diagnóstico
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>