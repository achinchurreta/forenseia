---
import BaseLayout from "../layouts/BaseLayout.astro";

import Container from "../components/ui/Container.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import Button from "../components/ui/Button.astro";
import Reveal from "../components/ui/Reveal.astro";

import { getCollection } from "astro:content";
import { services } from "../data/services";
import { courses } from "../data/courses";

const posts = (await getCollection("blog"))
  .filter((post) => post.data.status === "published")
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
  );

const latestPosts = posts.slice(0, 3);
---

<BaseLayout
  title="ForenseIA | Inteligencia aplicada para instituciones"
  description="Inteligencia artificial, investigación digital, ciberseguridad y psicología criminal aplicada para instituciones y organizaciones."
>
  <section class="relative min-h-screen overflow-hidden pt-24">
    <div class="absolute inset-0 bg-black"></div>

    <div
      class="absolute right-[-160px] top-[-180px] h-[760px] w-[760px] rounded-full bg-[#C8A96B]/10 blur-[180px]"
    ></div>

    <div
      class="absolute bottom-[-260px] left-[-220px] h-[640px] w-[640px] rounded-full bg-white/[0.025] blur-[160px]"
    ></div>

    <div
      class="absolute inset-0 opacity-[0.025] bg-[linear-gradient(rgba(255,255,255,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.08)_1px,transparent_1px)] bg-[size:96px_96px]"
    ></div>

    <Container class="relative z-10">
      <div class="flex min-h-[calc(100vh-6rem)] items-center">
        <div class="grid w-full items-center gap-16 lg:grid-cols-[1.15fr_0.85fr]">
          <Reveal>
            <div class="max-w-4xl">
              <p class="text-xs uppercase tracking-[0.4em] text-[#C8A96B] md:text-sm">
                Inteligencia aplicada
              </p>

              <h1 class="mt-7 text-5xl font-semibold leading-[0.94] tracking-[-0.06em] md:text-7xl xl:text-8xl">
                Conocimiento especializado para decisiones complejas.
              </h1>

              <p class="mt-8 max-w-2xl text-lg leading-relaxed text-white/55 md:text-xl">
                Integramos inteligencia artificial, investigación digital,
                ciberseguridad y psicología criminal para instituciones,
                fiscalías, agencias y organizaciones.
              </p>

              <div class="mt-10 flex flex-wrap gap-4">
                <Button href="/contacto">
                  Solicitar diagnóstico
                </Button>

                <Button href="/blog" variant="secondary">
                  Explorar biblioteca
                </Button>
              </div>
            </div>
          </Reveal>

          <Reveal delay={140}>
            <div class="relative flex justify-center lg:justify-end">
              <div
                class="absolute h-[360px] w-[360px] rounded-full bg-[#C8A96B]/10 blur-[110px]"
              ></div>

              <div class="relative border border-white/10 bg-white/[0.02] p-10">
                <img
                  src="/logo.png"
                  alt="ForenseIA"
                  class="w-[220px] object-contain md:w-[320px]"
                />

                <div class="mt-8 border-t border-white/10 pt-6 text-center">
                  <p class="text-xs uppercase tracking-[0.3em] text-white/30">
                    Tecnología · Investigación · Psicología
                  </p>
                </div>
              </div>
            </div>
          </Reveal>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-24">
    <Container>
      <div class="grid items-start gap-14 lg:grid-cols-[0.7fr_1.3fr]">
        <Reveal>
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
              Quiénes somos
            </p>

            <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-[-0.04em] md:text-6xl">
              Una plataforma con tres áreas especializadas.
            </h2>
          </div>
        </Reveal>

        <Reveal delay={120}>
          <div class="grid gap-4 md:grid-cols-3">
            <article class="border border-white/10 bg-white/[0.02] p-6">
              <p class="text-xs uppercase tracking-[0.25em] text-[#C8A96B]">
                Área 01
              </p>

              <h3 class="mt-5 text-2xl font-semibold">
                Inteligencia Artificial
              </h3>

              <p class="mt-4 text-sm leading-relaxed text-white/45">
                Soluciones para gobierno, instituciones y procesos estratégicos.
              </p>
            </article>

            <article class="border border-white/10 bg-white/[0.02] p-6">
              <p class="text-xs uppercase tracking-[0.25em] text-[#C8A96B]">
                Área 02
              </p>

              <h3 class="mt-5 text-2xl font-semibold">
                Investigación Digital
              </h3>

              <p class="mt-4 text-sm leading-relaxed text-white/45">
                OSINT, ciberseguridad y apoyo técnico para fiscalías y agencias.
              </p>
            </article>

            <article class="border border-white/10 bg-white/[0.02] p-6">
              <p class="text-xs uppercase tracking-[0.25em] text-[#C8A96B]">
                Área 03
              </p>

              <h3 class="mt-5 text-2xl font-semibold">
                Psicología Criminal
              </h3>

              <p class="mt-4 text-sm leading-relaxed text-white/45">
                Análisis conductual, prevención y capacitación especializada.
              </p>
            </article>
          </div>
        </Reveal>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02] py-24">
    <Container>
      <div class="mb-12 flex items-end justify-between gap-8">
        <Reveal>
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
              Biblioteca
            </p>

            <h2 class="mt-5 text-4xl font-semibold md:text-5xl">
              Últimos artículos
            </h2>
          </div>
        </Reveal>

        <a
          href="/blog"
          class="hidden text-sm text-[#C8A96B] transition hover:opacity-80 md:block"
        >
          Ver todos →
        </a>
      </div>

      {latestPosts.length === 0 ? (
        <div class="border border-white/10 bg-black/30 p-8">
          <p class="text-white/50">
            Próximamente publicaremos artículos especializados.
          </p>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-3">
          {latestPosts.map((post, index) => (
            <Reveal delay={index * 100}>
              <ServiceCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id}`}
                label="Leer artículo"
              />
            </Reveal>
          ))}
        </div>
      )}
    </Container>
  </section>

  <section class="border-t border-white/10 py-24">
    <Container>
      <Reveal>
        <div class="mb-12 max-w-2xl">
          <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
            Servicios
          </p>

          <h2 class="mt-5 text-4xl font-semibold md:text-5xl">
            Soluciones por especialidad.
          </h2>
        </div>
      </Reveal>

      <div class="grid gap-6 md:grid-cols-3">
        {services.slice(0, 3).map((service, index) => (
          <Reveal delay={index * 100}>
            <ServiceCard
              title={service.title}
              description={service.description}
              href={service.href}
              label="Ver servicio"
            />
          </Reveal>
        ))}
      </div>

      <div class="mt-10">
        <Button href="/servicios" variant="secondary">
          Ver todos los servicios
        </Button>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02] py-24">
    <Container>
      <div class="grid items-start gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <Reveal>
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
              Formación
            </p>

            <h2 class="mt-5 text-4xl font-semibold md:text-5xl">
              Cursos para equipos e instituciones.
            </h2>

            <p class="mt-5 max-w-lg leading-relaxed text-white/50">
              Programas claros, especializados y orientados a aplicación real.
            </p>

            <div class="mt-8">
              <Button href="/cursos" variant="secondary">
                Ver cursos
              </Button>
            </div>
          </div>
        </Reveal>

        <div class="grid gap-6 md:grid-cols-2">
          {courses.slice(0, 2).map((course, index) => (
            <Reveal delay={index * 100}>
              <ServiceCard
                title={course.title}
                description={`${course.duration} · ${course.modality}`}
                href={course.href}
                label="Ver curso"
              />
            </Reveal>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-28">
    <Container>
      <Reveal>
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
            Contacto
          </p>

          <h2 class="mt-5 text-4xl font-semibold tracking-[-0.04em] md:text-6xl">
            Encuentra el área adecuada para tu necesidad.
          </h2>

          <p class="mx-auto mt-6 max-w-xl leading-relaxed text-white/50">
            Cuéntanos el contexto y te conectamos con la dirección especializada.
          </p>

          <div class="mt-10">
            <Button href="/contacto">
              Contactar al equipo
            </Button>
          </div>
        </div>
      </Reveal>
    </Container>
  </section>
</BaseLayout>