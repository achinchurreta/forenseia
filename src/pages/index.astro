---
import BaseLayout from "../layouts/BaseLayout.astro";

import Container from "../components/ui/Container.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import Button from "../components/ui/Button.astro";
import Reveal from "../components/ui/Reveal.astro";

import { getCollection } from "astro:content";
import { services } from "../data/services";
import { courses } from "../data/courses";

const posts = await getCollection("blog");

const latestPosts = posts
  .sort((a: any, b: any) => {
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3);
---

<BaseLayout title="ForenseIA | Inteligencia, Tecnología e Investigación Digital">
  <section class="relative min-h-screen flex items-center overflow-hidden pt-24">
    <div class="absolute inset-0 bg-black"></div>
    <div class="absolute right-[-120px] top-[-120px] h-[720px] w-[720px] rounded-full bg-[#C8A96B]/10 blur-[160px]"></div>
    <div class="absolute left-[-120px] bottom-[-160px] h-[520px] w-[520px] rounded-full bg-white/[0.03] blur-[140px]"></div>

    <Container class="relative z-10">
      <div class="max-w-5xl">
        <Reveal>
          <p class="text-[#C8A96B] uppercase tracking-[0.35em] text-sm">
            ForenseIA
          </p>

          <h1 class="mt-8 text-5xl md:text-8xl font-semibold leading-[0.95] tracking-[-0.06em]">
            Tecnología, inteligencia y conocimiento para resolver problemas complejos.
          </h1>

          <p class="mt-8 max-w-2xl text-lg md:text-xl leading-relaxed text-white/55">
            Desarrollamos soluciones en inteligencia artificial, investigación digital y ciberseguridad aplicada para instituciones, organizaciones y profesionales.
          </p>

          <div class="mt-10 flex flex-wrap gap-4">
            <Button href="/blog">Explorar biblioteca</Button>
            <Button href="/contacto" variant="secondary">Solicitar diagnóstico</Button>
          </div>
        </Reveal>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-24">
    <Container>
      <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 items-start">
        <Reveal>
          <div>
            <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
              Quiénes somos
            </p>

            <h2 class="mt-5 text-4xl md:text-6xl font-semibold tracking-[-0.04em] leading-tight">
              Inteligencia aplicada para decisiones reales.
            </h2>
          </div>
        </Reveal>

        <Reveal delay={120}>
          <div class="space-y-6">
            <p class="text-white/60 text-lg leading-relaxed">
              ForenseIA es una plataforma especializada en inteligencia artificial, investigación digital y ciberseguridad aplicada.
            </p>

            <p class="text-white/50 leading-relaxed">
              Creamos conocimiento, capacitamos equipos y desarrollamos soluciones para ordenar información, reducir riesgos y apoyar la toma de decisiones estratégicas.
            </p>

            <div class="grid md:grid-cols-3 gap-4 pt-4">
              <div class="border border-white/10 p-5">
                <h3 class="font-semibold">Investigación</h3>
                <p class="mt-3 text-sm text-white/45">
                  OSINT, auditoría forense e inteligencia patrimonial.
                </p>
              </div>

              <div class="border border-white/10 p-5">
                <h3 class="font-semibold">Tecnología</h3>
                <p class="mt-3 text-sm text-white/45">
                  IA aplicada, automatización y soluciones digitales.
                </p>
              </div>

              <div class="border border-white/10 p-5">
                <h3 class="font-semibold">Formación</h3>
                <p class="mt-3 text-sm text-white/45">
                  Cursos, talleres y programas especializados.
                </p>
              </div>
            </div>
          </div>
        </Reveal>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02] py-24">
    <Container>
      <Reveal>
        <div class="mb-12 max-w-2xl">
          <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
            Biblioteca
          </p>

          <h2 class="mt-5 text-4xl md:text-5xl font-semibold">
            Últimos artículos
          </h2>
        </div>
      </Reveal>

      {latestPosts.length === 0 ? (
        <div class="border border-white/10 bg-white/[0.03] p-8">
          <p class="text-white/50">Pronto publicaremos artículos especializados.</p>
        </div>
      ) : (
        <div class="grid md:grid-cols-3 gap-6">
          {latestPosts.map((post: any, index: number) => (
            <Reveal delay={index * 100}>
              <ServiceCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.slug}`}
                label="Leer artículo"
              />
            </Reveal>
          ))}
        </div>
      )}

      <div class="mt-10">
        <Button href="/blog" variant="secondary">Ver biblioteca</Button>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-24">
    <Container>
      <Reveal>
        <div class="mb-12 max-w-2xl">
          <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
            Servicios
          </p>

          <h2 class="mt-5 text-4xl md:text-5xl font-semibold">
            Áreas principales
          </h2>
        </div>
      </Reveal>

      <div class="grid md:grid-cols-3 gap-6">
        {services.slice(0, 3).map((service, index) => (
          <Reveal delay={index * 100}>
            <ServiceCard
              title={service.title}
              description={service.description}
              href={service.href}
              label="Ver área"
            />
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02] py-24">
    <Container>
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 items-start">
        <Reveal>
          <div>
            <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
              Cursos
            </p>

            <h2 class="mt-5 text-4xl md:text-5xl font-semibold">
              Formación práctica.
            </h2>

            <p class="mt-5 text-white/50 leading-relaxed">
              Cursos claros, cortos y orientados a aplicación real.
            </p>

            <div class="mt-8">
              <Button href="/cursos" variant="secondary">Ver cursos</Button>
            </div>
          </div>
        </Reveal>

        <div class="grid md:grid-cols-2 gap-6">
          {courses.slice(0, 2).map((course, index) => (
            <Reveal delay={index * 100}>
              <ServiceCard
                title={course.title}
                description={`${course.duration} · ${course.modality}`}
                href={course.href}
                label="Ver curso"
              />
            </Reveal>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-28">
    <Container>
      <Reveal>
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
            Contacto
          </p>

          <h2 class="mt-5 text-4xl md:text-6xl font-semibold tracking-[-0.04em]">
            ¿Necesitas capacitar un equipo o analizar un caso?
          </h2>

          <div class="mt-10 flex justify-center gap-4">
            <Button href="/contacto">Contactar</Button>
            <Button href="/blog" variant="secondary">Leer artículos</Button>
          </div>
        </div>
      </Reveal>
    </Container>
  </section>
</BaseLayout>