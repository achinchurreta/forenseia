---
import BaseLayout from "../layouts/BaseLayout.astro";

import Container from "../components/ui/Container.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import Button from "../components/ui/Button.astro";
import Reveal from "../components/ui/Reveal.astro";

import { services } from "../data/services";
import { courses } from "../data/courses";
---

<BaseLayout title="ForenseIA | Inteligencia Artificial e Investigación Digital">
  <section class="relative min-h-screen flex items-center overflow-hidden pt-24">
    <div class="absolute inset-0 bg-black"></div>
    <div class="absolute right-0 top-0 h-[700px] w-[700px] rounded-full bg-[#C8A96B]/10 blur-[160px]"></div>

    <Container class="relative z-10">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <Reveal>
          <div class="max-w-2xl">
            <p class="text-[#C8A96B] uppercase tracking-[0.35em] text-sm">
              Inteligencia aplicada
            </p>

            <h1 class="mt-7 text-5xl md:text-7xl font-semibold leading-[0.96] tracking-[-0.05em]">
              IA e investigación digital para decisiones estratégicas.
            </h1>

            <p class="mt-8 max-w-xl text-lg leading-relaxed text-white/55">
              Formación, análisis y servicios especializados en inteligencia artificial,
              OSINT, ciberseguridad y auditoría forense.
            </p>

            <div class="mt-10 flex flex-wrap gap-4">
              <Button href="/contacto">Solicitar diagnóstico</Button>
              <Button href="/blog" variant="secondary">Leer blog</Button>
            </div>
          </div>
        </Reveal>

        <Reveal delay={120}>
          <div class="flex justify-center lg:justify-end">
            <img
              src="/logo.png"
              alt="ForenseIA"
              class="w-[250px] md:w-[390px] object-contain drop-shadow-[0_0_60px_rgba(200,169,107,0.22)]"
            />
          </div>
        </Reveal>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-20">
    <Container>
      <Reveal>
        <div class="max-w-2xl mb-10">
          <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
            Plataforma
          </p>

          <h2 class="mt-4 text-4xl font-semibold">
            Tres formas de usar ForenseIA.
          </h2>
        </div>
      </Reveal>

      <div class="grid md:grid-cols-3 gap-6">
        <Reveal>
          <div class="border border-white/10 bg-white/[0.03] p-8">
            <h3 class="text-2xl font-semibold">Aprender</h3>
            <p class="mt-4 text-white/50 leading-relaxed">
              Cursos prácticos y contenido especializado.
            </p>
          </div>
        </Reveal>

        <Reveal delay={100}>
          <div class="border border-white/10 bg-white/[0.03] p-8">
            <h3 class="text-2xl font-semibold">Investigar</h3>
            <p class="mt-4 text-white/50 leading-relaxed">
              Artículos, análisis y metodología aplicada.
            </p>
          </div>
        </Reveal>

        <Reveal delay={200}>
          <div class="border border-white/10 bg-white/[0.03] p-8">
            <h3 class="text-2xl font-semibold">Resolver</h3>
            <p class="mt-4 text-white/50 leading-relaxed">
              Diagnósticos, consultoría y servicios técnicos.
            </p>
          </div>
        </Reveal>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02] py-20">
    <Container>
      <div class="flex items-end justify-between gap-6 mb-10">
        <div>
          <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
            Servicios
          </p>

          <h2 class="mt-4 text-4xl font-semibold">
            Áreas principales
          </h2>
        </div>

        <a href="/servicios" class="hidden md:block text-[#C8A96B]">
          Ver servicios →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {services.slice(0, 3).map((service, index) => (
          <Reveal delay={index * 100}>
            <ServiceCard
              title={service.title}
              description={service.description}
              href={service.href}
              label="Ver más"
            />
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-20">
    <Container>
      <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 items-start">
        <Reveal>
          <div>
            <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
              Cursos
            </p>

            <h2 class="mt-4 text-4xl font-semibold">
              Formación sin complicaciones.
            </h2>

            <p class="mt-5 text-white/50 leading-relaxed">
              Cursos claros, prácticos y orientados a aplicación real.
            </p>

            <div class="mt-8">
              <Button href="/cursos" variant="secondary">
                Ver cursos
              </Button>
            </div>
          </div>
        </Reveal>

        <div class="grid md:grid-cols-2 gap-6">
          {courses.slice(0, 2).map((course, index) => (
            <Reveal delay={index * 100}>
              <ServiceCard
                title={course.title}
                description={`${course.duration} · ${course.modality}`}
                href={course.href}
                label="Ver curso"
              />
            </Reveal>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 py-24">
    <Container>
      <Reveal>
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
            Blog
          </p>

          <h2 class="mt-5 text-4xl md:text-5xl font-semibold">
            El contenido profundo vive en el blog.
          </h2>

          <p class="mx-auto mt-6 max-w-xl text-white/50 leading-relaxed">
            Ahí publicaremos artículos, guías, análisis, casos y material técnico.
          </p>

          <div class="mt-9 flex justify-center gap-4">
            <Button href="/blog">Leer blog</Button>
            <Button href="/contacto" variant="secondary">
              Contactar
            </Button>
          </div>
        </div>
      </Reveal>
    </Container>
  </section>
</BaseLayout>