---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Nosotros | ForenseIA">
  <PageHeader
    eyebrow="Nosotros"
    title="Una plataforma de IA, ciberseguridad e investigación digital."
    description="ForenseIA une formación, análisis técnico y servicios especializados para convertir información compleja en decisiones claras."
  />

  <section class="py-20">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-4xl font-semibold">
            Menos ruido. Más método.
          </h2>
        </div>

        <div class="space-y-5 text-white/55 leading-relaxed">
          <p>
            ForenseIA nace para enseñar, investigar y aplicar tecnología en contextos donde la información necesita orden, criterio y trazabilidad.
          </p>

          <p>
            Trabajamos en dos líneas principales: inteligencia artificial aplicada y análisis digital para OSINT, ciberseguridad, auditoría forense e inteligencia patrimonial.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02] py-20">
    <Container>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="border border-white/10 p-8">
          <h3 class="text-2xl font-semibold">IA aplicada</h3>
          <p class="text-white/50 mt-4">
            Automatización, análisis inteligente y soluciones prácticas.
          </p>
        </div>

        <div class="border border-white/10 p-8">
          <h3 class="text-2xl font-semibold">Investigación digital</h3>
          <p class="text-white/50 mt-4">
            OSINT, ciberseguridad, exposición digital y análisis técnico.
          </p>
        </div>

        <div class="border border-white/10 p-8">
          <h3 class="text-2xl font-semibold">Formación</h3>
          <p class="text-white/50 mt-4">
            Cursos y contenidos para aprender con claridad.
          </p>
        </div>
      </div>

      <div class="mt-12">
        <Button href="/contacto">
          Contactar
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>