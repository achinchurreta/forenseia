---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import { authors } from "../data/authors";
---

<BaseLayout title="Nosotros | ForenseIA">
  <PageHeader
    eyebrow="Nosotros"
    title="Una plataforma de inteligencia aplicada."
    description="ForenseIA une tecnología, conocimiento e investigación para resolver problemas complejos con método, claridad y criterio técnico."
  />

  <section class="py-24">
    <Container>
      <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12">
        <h2 class="text-4xl md:text-6xl font-semibold leading-tight tracking-[-0.04em]">
          Inteligencia artificial, ciberseguridad e investigación digital aplicada.
        </h2>

        <div class="space-y-6 text-white/55 leading-relaxed text-lg">
          <p>
            ForenseIA nace como una plataforma especializada en formación, análisis y servicios técnicos para instituciones, organizaciones y profesionales.
          </p>

          <p>
            Integramos dos líneas complementarias: inteligencia artificial aplicada para gobierno e instituciones, e investigación digital con enfoque en OSINT, ciberseguridad, auditoría forense e inteligencia patrimonial.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02] py-24">
    <Container>
      <div class="mb-12">
        <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
          Equipo
        </p>

        <h2 class="mt-5 text-4xl md:text-5xl font-semibold">
          Líneas de especialización
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {authors.map((author) => (
          <article class="border border-white/10 bg-black/40 p-8">
            <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
              {author.role}
            </p>

            <h3 class="mt-5 text-3xl font-semibold">
              {author.name}
            </h3>

            <p class="mt-4 text-white/55 leading-relaxed">
              {author.description}
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {author.areas.map((area) => (
                <span class="border border-white/10 px-3 py-2 text-sm text-white/50">
                  {area}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12">
        <Button href="/contacto">
          Contactar
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>