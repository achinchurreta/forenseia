---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import { authors } from "../data/authors";
---

<BaseLayout title="Nosotros | ForenseIA">
  <PageHeader
    eyebrow="Nosotros"
    title="Conocimiento especializado para instituciones y organizaciones."
    description="ForenseIA integra inteligencia artificial, investigación digital, ciberseguridad y psicología aplicada."
  />

  <section class="py-24">
    <Container>
      <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12">
        <div>
          <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
            Quiénes somos
          </p>

          <h2 class="mt-5 text-4xl md:text-6xl font-semibold leading-tight tracking-[-0.04em]">
            Tres especialidades. Una plataforma.
          </h2>
        </div>

        <div class="space-y-6 text-white/55 leading-relaxed text-lg">
          <p>
            ForenseIA es una plataforma de conocimiento, formación y servicios
            especializados para instituciones públicas, organizaciones de
            investigación y equipos profesionales.
          </p>

          <p>
            Integramos inteligencia artificial, investigación digital,
            ciberseguridad y psicología aplicada para capacitar personal,
            analizar información y apoyar decisiones en contextos
            institucionales y operativos.
          </p>

          <p>
            Nuestra línea de investigación digital está especialmente orientada
            a fiscalías, agencias de inteligencia, instituciones navales,
            policías de investigación y grupos especializados que requieren
            metodologías OSINT, análisis de vínculos, inteligencia patrimonial y
            apoyo técnico en investigaciones complejas.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-white/10 bg-white/[0.02] py-24">
    <Container>
      <div class="mb-12">
        <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
          Equipo
        </p>

        <h2 class="mt-5 text-4xl md:text-5xl font-semibold">
          Líneas de especialización
        </h2>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        {authors.map((author) => (
          <article class="border border-white/10 bg-black/40 p-8">
            <p class="text-[#C8A96B] uppercase tracking-[0.25em] text-xs">
              {author.role}
            </p>

            <h3 class="mt-5 text-3xl font-semibold">
              {author.name}
            </h3>

            <p class="mt-2 text-sm text-white/35">
              {author.audience}
            </p>

            <p class="mt-5 text-white/55 leading-relaxed">
              {author.description}
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {author.areas.map((area) => (
                <span class="border border-white/10 px-3 py-2 text-sm text-white/50">
                  {area}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12">
        <Button href="/contacto">
          Contactar al equipo
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>