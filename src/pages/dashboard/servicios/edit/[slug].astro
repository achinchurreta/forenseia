---
import DashboardLayout from "../../../../components/dashboard/DashboardLayout.astro";

import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");

  return services.map((service) => ({
    params: {
      slug: String(service.id),
    },
    props: {
      service,
    },
  }));
}

interface Props {
  service: CollectionEntry<"services">;
}

const { service } = Astro.props as Props;

const content =
  "body" in service && typeof service.body === "string"
    ? service.body
    : "";

const directors = [
  "Gonzalo García",
  "Augusto Chinchurreta",
  "Tania Pérez",
];

const areas = [
  "Inteligencia Artificial",
  "Investigación Digital y Ciberseguridad",
  "Psicología Criminal",
];

const formattedDate = new Date(service.data.date)
  .toISOString()
  .split("T")[0];
---

<DashboardLayout title={`Editar ${service.data.title} | ForenseIA`}>
  <div
    id="edit-page"
    data-current-owner={service.data.director}
    data-current-area={service.data.area}
    class="max-w-5xl"
  >
    <div class="mb-10">
      <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
        Servicios / Editar
      </p>

      <h1 class="mt-5 text-4xl font-semibold tracking-[-0.04em] md:text-5xl">
        Editar servicio
      </h1>

      <p class="mt-4 max-w-2xl leading-relaxed text-white/45">
        Actualiza la información, dirección responsable, estado y contenido
        completo del servicio.
      </p>

      <div
        id="role-notice"
        class="mt-6 hidden border border-[#C8A96B]/20 bg-[#C8A96B]/5 p-4 text-sm leading-relaxed text-white/55"
      ></div>

      <div
        id="access-denied"
        class="mt-6 hidden border border-red-400/20 bg-red-500/5 p-5"
      >
        <p class="font-medium text-red-300">
          No tienes permiso para editar este servicio.
        </p>

        <p class="mt-2 text-sm leading-relaxed text-white/45">
          Este servicio pertenece a otra dirección especializada.
        </p>

        <a
          href="/dashboard/servicios"
          class="mt-5 inline-flex border border-red-400/30 px-5 py-3 text-sm text-red-200 transition hover:bg-red-500/10"
        >
          Volver a servicios
        </a>
      </div>
    </div>

    <form
      id="content-form"
      class="space-y-6"
    >
      <input
        type="hidden"
        name="currentSlug"
        value={service.id}
      />

      <input
        type="hidden"
        name="contentType"
        value="service"
      />

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label
            for="title"
            class="mb-2 block text-sm text-white/50"
          >
            Título del servicio
          </label>

          <input
            id="title"
            name="title"
            required
            value={service.data.title}
            class="input"
          />
        </div>

        <div>
          <label
            for="slug"
            class="mb-2 block text-sm text-white/50"
          >
            Slug
          </label>

          <input
            id="slug"
            name="slug"
            required
            value={service.id}
            class="input"
          />

          <p class="mt-2 text-xs text-white/30">
            Cambiarlo modificará la URL pública del servicio.
          </p>
        </div>
      </div>

      <div>
        <label
          for="description"
          class="mb-2 block text-sm text-white/50"
        >
          Descripción breve
        </label>

        <textarea
          id="description"
          name="description"
          required
          rows="4"
          maxlength="220"
          class="input"
        >{service.data.description}</textarea>

        <div class="mt-2 flex justify-between gap-4 text-xs text-white/30">
          <span>
            Esta descripción aparecerá en el catálogo público.
          </span>

          <span id="description-counter">
            {service.data.description.length} / 220
          </span>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label
            for="area"
            class="mb-2 block text-sm text-white/50"
          >
            Área
          </label>

          <select
            id="area"
            name="area"
            required
            class="input"
          >
            {!areas.includes(service.data.area) && (
              <option
                value={service.data.area}
                selected
              >
                {service.data.area}
              </option>
            )}

            {areas.map((area) => (
              <option
                value={area}
                selected={service.data.area === area}
              >
                {area}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label
            for="director"
            class="mb-2 block text-sm text-white/50"
          >
            Director responsable
          </label>

          <select
            id="director"
            name="director"
            required
            class="input"
          >
            {!directors.includes(service.data.director) && (
              <option
                value={service.data.director}
                selected
              >
                {service.data.director}
              </option>
            )}

            {directors.map((director) => (
              <option
                value={director}
                selected={service.data.director === director}
              >
                {director}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div>
        <label
          for="audience"
          class="mb-2 block text-sm text-white/50"
        >
          Público objetivo
        </label>

        <input
          id="audience"
          name="audience"
          required
          value={service.data.audience}
          class="input"
        />
      </div>

      <div class="grid gap-6 md:grid-cols-4">
        <div>
          <label
            for="order"
            class="mb-2 block text-sm text-white/50"
          >
            Orden
          </label>

          <input
            id="order"
            name="order"
            type="number"
            min="0"
            value={service.data.order}
            class="input"
          />

          <p class="mt-2 text-xs text-white/30">
            Los valores menores aparecen primero.
          </p>
        </div>

        <div>
          <label
            for="status"
            class="mb-2 block text-sm text-white/50"
          >
            Estado
          </label>

          <select
            id="status"
            name="status"
            required
            class="input"
          >
            <option
              value="published"
              selected={service.data.status === "published"}
            >
              Publicado
            </option>

            <option
              value="draft"
              selected={service.data.status === "draft"}
            >
              Borrador
            </option>
          </select>
        </div>

        <div>
          <label
            for="date"
            class="mb-2 block text-sm text-white/50"
          >
            Fecha
          </label>

          <input
            id="date"
            name="date"
            type="date"
            required
            value={formattedDate}
            class="input"
          />
        </div>

        <div>
          <label
            for="cover"
            class="mb-2 block text-sm text-white/50"
          >
            URL de portada
          </label>

          <input
            id="cover"
            name="cover"
            type="url"
            value={service.data.cover ?? ""}
            placeholder="https://..."
            class="input"
          />
        </div>
      </div>

      <label class="flex w-fit items-center gap-3 border border-white/10 bg-white/[0.02] px-4 py-4 text-sm text-white/55">
        <input
          id="featured"
          name="featured"
          type="checkbox"
          value="true"
          checked={service.data.featured}
          class="h-4 w-4 accent-[#C8A96B]"
        />

        Mostrar como servicio destacado
      </label>

      <div>
        <label
          for="content"
          class="mb-2 block text-sm text-white/50"
        >
          Información completa
        </label>

        <textarea
          id="content"
          name="content"
          required
          rows="24"
          class="input min-h-[600px] font-mono leading-relaxed"
        >{content}</textarea>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button
          id="save-button"
          type="submit"
          class="bg-[#C8A96B] px-8 py-4 font-medium text-black transition hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Guardar cambios
        </button>

        <a
          href="/dashboard/servicios"
          class="border border-white/10 px-8 py-4 text-white/55 transition hover:border-[#C8A96B]/60 hover:text-[#C8A96B]"
        >
          Cancelar
        </a>

        {service.data.status === "published" && (
          <a
            href={`/servicios/${service.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-white/10 px-8 py-4 text-white/55 transition hover:border-[#C8A96B]/60 hover:text-[#C8A96B]"
          >
            Ver servicio
          </a>
        )}
      </div>

      <p
        id="message"
        class="min-h-6 text-sm text-white/50"
      ></p>
    </form>
  </div>

  <style>
    .input {
      width: 100%;
      border: 1px solid rgb(255 255 255 / 0.1);
      background: #000;
      padding: 1rem;
      color: #fff;
      outline: none;
      transition:
        border-color 180ms ease,
        background-color 180ms ease,
        opacity 180ms ease;
    }

    .input:focus {
      border-color: #c8a96b;
      background: rgb(255 255 255 / 0.015);
    }

    .input:disabled {
      cursor: not-allowed;
      border-color: rgb(200 169 107 / 0.25);
      background: rgb(200 169 107 / 0.04);
      color: rgb(255 255 255 / 0.55);
      opacity: 1;
    }

    .input::placeholder {
      color: rgb(255 255 255 / 0.25);
    }
  </style>

  <script is:inline>
    const editPage = document.getElementById("edit-page");
    const form = document.getElementById("content-form");
    const saveButton = document.getElementById("save-button");
    const message = document.getElementById("message");
    const roleNotice = document.getElementById("role-notice");
    const accessDenied = document.getElementById("access-denied");

    const titleInput = document.getElementById("title");
    const slugInput = document.getElementById("slug");
    const descriptionInput = document.getElementById("description");
    const descriptionCounter = document.getElementById(
      "description-counter"
    );

    const directorSelect = document.getElementById("director");
    const areaSelect = document.getElementById("area");
    const featuredInput = document.getElementById("featured");

    const currentOwner =
      editPage?.dataset.currentOwner || "";

    let currentUser = null;
    let accessAllowed = false;

    const ROLE_RULES = {
      "director-ia": {
        owner: "Gonzalo García",
        areas: [
          "Inteligencia Artificial",
        ],
        notice:
          "Estás editando un servicio de la Dirección de Inteligencia Artificial. El director permanecerá como Gonzalo García.",
      },

      "director-psychology": {
        owner: "Tania Pérez",
        areas: [
          "Psicología Criminal",
        ],
        notice:
          "Estás editando un servicio de la Dirección de Psicología Criminal. La directora permanecerá como Tania Pérez.",
      },
    };

    function createSlug(value) {
      return String(value)
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    function updateDescriptionCounter() {
      if (
        !(descriptionInput instanceof HTMLTextAreaElement) ||
        !descriptionCounter
      ) {
        return;
      }

      descriptionCounter.textContent =
        `${descriptionInput.value.length} / 220`;
    }

    function resetAreaOptions() {
      if (!(areaSelect instanceof HTMLSelectElement)) {
        return;
      }

      Array.from(areaSelect.options).forEach((option) => {
        option.hidden = false;
        option.disabled = false;
      });
    }

    function restrictAreaOptions(allowedAreas) {
      if (!(areaSelect instanceof HTMLSelectElement)) {
        return;
      }

      Array.from(areaSelect.options).forEach((option) => {
        const allowed = allowedAreas.includes(option.value);

        option.hidden = !allowed;
        option.disabled = !allowed;
      });

      if (!allowedAreas.includes(areaSelect.value)) {
        areaSelect.value = allowedAreas[0];
      }
    }

    function disableForm() {
      form?.querySelectorAll(
        "input, textarea, select, button"
      ).forEach((element) => {
        element.disabled = true;
      });

      form?.classList.add("hidden");
      accessDenied?.classList.remove("hidden");
    }

    function enableForm() {
      form?.classList.remove("hidden");
      accessDenied?.classList.add("hidden");
    }

    function applyUserRestrictions(user) {
      currentUser = user;
      accessAllowed = false;

      if (
        !(directorSelect instanceof HTMLSelectElement) ||
        !(areaSelect instanceof HTMLSelectElement)
      ) {
        disableForm();
        return;
      }

      directorSelect.disabled = false;
      areaSelect.disabled = false;

      resetAreaOptions();

      roleNotice?.classList.add("hidden");

      if (roleNotice) {
        roleNotice.textContent = "";
      }

      if (user.role === "admin") {
        accessAllowed = true;
        enableForm();
        return;
      }

      const rules = ROLE_RULES[user.role];

      if (!rules || currentOwner !== rules.owner) {
        disableForm();
        return;
      }

      accessAllowed = true;
      enableForm();

      directorSelect.value = rules.owner;
      directorSelect.disabled = true;

      restrictAreaOptions(rules.areas);

      if (roleNotice) {
        roleNotice.textContent = rules.notice;
        roleNotice.classList.remove("hidden");
      }
    }

    function loadStoredUser() {
      try {
        const storedUser = JSON.parse(
          sessionStorage.getItem("forenseia_user") || "null"
        );

        if (storedUser) {
          applyUserRestrictions(storedUser);
        }
      } catch (error) {
        console.error(
          "No se pudo leer el usuario almacenado:",
          error
        );

        sessionStorage.removeItem("forenseia_user");
      }
    }

    loadStoredUser();
    updateDescriptionCounter();

    document.addEventListener(
      "forenseia:user-ready",
      (event) => {
        applyUserRestrictions(event.detail);
      }
    );

    descriptionInput?.addEventListener(
      "input",
      updateDescriptionCounter
    );

    titleInput?.addEventListener("input", () => {
      if (
        !(titleInput instanceof HTMLInputElement) ||
        !(slugInput instanceof HTMLInputElement) ||
        slugInput.dataset.edited === "true"
      ) {
        return;
      }

      slugInput.value = createSlug(titleInput.value);
    });

    slugInput?.addEventListener("input", () => {
      if (!(slugInput instanceof HTMLInputElement)) {
        return;
      }

      slugInput.dataset.edited =
        slugInput.value.length > 0
          ? "true"
          : "false";
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (
        !accessAllowed ||
        !currentUser ||
        !form ||
        !saveButton ||
        !message
      ) {
        if (message) {
          message.textContent =
            "No tienes permiso para editar este servicio.";
        }

        return;
      }

      const formData = new FormData(form);
      const payload = Object.fromEntries(
        formData.entries()
      );

      payload.contentType = "service";
      payload.featured =
        featuredInput instanceof HTMLInputElement
          ? featuredInput.checked
          : false;

      if (directorSelect instanceof HTMLSelectElement) {
        payload.director = directorSelect.value;
      }

      if (areaSelect instanceof HTMLSelectElement) {
        payload.area = areaSelect.value;
      }

      if (currentUser.role === "director-ia") {
        payload.director = "Gonzalo García";
        payload.area = "Inteligencia Artificial";
      }

      if (currentUser.role === "director-psychology") {
        payload.director = "Tania Pérez";
        payload.area = "Psicología Criminal";
      }

      saveButton.disabled = true;
      saveButton.textContent = "Guardando...";
      message.textContent = "Actualizando servicio...";

      try {
        const response = await fetch(
          "/.netlify/functions/update-content",
          {
            method: "POST",
            credentials: "include",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          }
        );

        const text = await response.text();

        let data = {};

        try {
          data = text ? JSON.parse(text) : {};
        } catch {
          throw new Error(
            text ||
              "La función devolvió una respuesta inválida"
          );
        }

        if (!response.ok) {
          throw new Error(
            data.error ||
              "No se pudo actualizar el servicio"
          );
        }

        message.textContent =
          "Servicio actualizado. Netlify iniciará un nuevo despliegue.";

        setTimeout(() => {
          window.location.href = "/dashboard/servicios";
        }, 1400);
      } catch (error) {
        message.textContent =
          error instanceof Error
            ? `Error: ${error.message}`
            : "No se pudo actualizar el servicio.";

        saveButton.disabled = false;
        saveButton.textContent = "Guardar cambios";
      }
    });
  </script>
</DashboardLayout>