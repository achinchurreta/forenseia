---
import DashboardLayout from "../../../components/dashboard/DashboardLayout.astro";
import { getCollection } from "astro:content";

const courses = (await getCollection("courses")).sort(
  (a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
);

const publishedCourses = courses.filter(
  (course) => course.data.status === "published"
);

const draftCourses = courses.filter(
  (course) => course.data.status === "draft"
);
---

<DashboardLayout title="Cursos | ForenseIA">
  <section>
    <div class="flex flex-col justify-between gap-8 xl:flex-row xl:items-end">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
          Formación
        </p>

        <h1 class="mt-5 text-4xl font-semibold tracking-[-0.04em] md:text-6xl">
          Catálogo de cursos
        </h1>

        <p class="mt-5 max-w-2xl leading-relaxed text-white/45">
          Crea y administra programas de formación por área,
          instructor y modalidad.
        </p>
      </div>

      <a
        href="/dashboard/cursos/new"
        class="inline-flex w-fit bg-[#C8A96B] px-6 py-4 font-medium text-black transition hover:opacity-90"
      >
        Nuevo curso
      </a>
    </div>
  </section>

  <section class="mt-12 grid gap-4 sm:grid-cols-3">
    <article class="border border-white/10 bg-white/[0.02] p-6">
      <p class="text-4xl font-semibold text-[#C8A96B]">
        {courses.length}
      </p>
      <p class="mt-4 text-white/45">Total</p>
    </article>

    <article class="border border-white/10 bg-white/[0.02] p-6">
      <p class="text-4xl font-semibold text-[#C8A96B]">
        {publishedCourses.length}
      </p>
      <p class="mt-4 text-white/45">Publicados</p>
    </article>

    <article class="border border-white/10 bg-white/[0.02] p-6">
      <p class="text-4xl font-semibold text-[#C8A96B]">
        {draftCourses.length}
      </p>
      <p class="mt-4 text-white/45">Borradores</p>
    </article>
  </section>

  <section class="mt-12 space-y-4">
    {courses.length === 0 ? (
      <div class="border border-white/10 bg-white/[0.02] p-8">
        <p class="text-white/45">
          Todavía no hay cursos creados.
        </p>
      </div>
    ) : (
      courses.map((course) => (
        <article class="flex flex-col justify-between gap-6 border border-white/10 bg-white/[0.02] p-6 lg:flex-row lg:items-center">
          <div class="max-w-3xl">
            <div class="flex flex-wrap gap-3 text-xs">
              <span class="text-[#C8A96B]">
                {course.data.area}
              </span>

              <span class="text-white/30">
                {course.data.status}
              </span>

              {course.data.featured && (
                <span class="text-white/30">
                  Destacado
                </span>
              )}
            </div>

            <h2 class="mt-4 text-2xl font-semibold">
              {course.data.title}
            </h2>

            <p class="mt-3 text-white/45">
              {course.data.description}
            </p>

            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm text-white/30">
              <span>{course.data.instructor}</span>
              <span>{course.data.duration}</span>
              <span>{course.data.modality}</span>
              <span>{course.data.level}</span>
            </div>
          </div>

          <a
            href={`/cursos/${course.id}`}
            target="_blank"
            class="w-fit border border-white/10 px-5 py-3 text-sm text-white/55 transition hover:border-[#C8A96B]/60 hover:text-[#C8A96B]"
          >
            Ver curso
          </a>
        </article>
      ))
    )}
  </section>
</DashboardLayout>