---
import DashboardLayout from "../../components/dashboard/DashboardLayout.astro";

const contentTypes = [
  {
    title: "Carrusel",
    description:
      "Convierte un tema o artículo en una secuencia visual para Instagram, Facebook o LinkedIn.",
    href: "/dashboard/contenido/carrusel",
    number: "01",
  },
  {
    title: "Reel",
    description:
      "Crea una idea breve con gancho, desarrollo y cierre para video vertical.",
    href: "/dashboard/contenido/reel",
    number: "02",
  },
  {
    title: "Publicación",
    description:
      "Redacta contenido corto para Facebook, Instagram, LinkedIn o X.",
    href: "/dashboard/contenido/publicacion",
    number: "03",
  },
  {
    title: "Historia",
    description:
      "Genera una historia rápida con pregunta, dato, encuesta o llamado a la acción.",
    href: "/dashboard/contenido/historia",
    number: "04",
  },
];

const areas = [
  {
    title: "Inteligencia Artificial",
    responsible: "Gonzalo García",
    audience: "Gobierno e instituciones",
  },
  {
    title: "Investigación Digital",
    responsible: "Augusto Chinchurreta",
    audience: "Fiscalías, agencias y unidades de investigación",
  },
  {
    title: "Psicología Criminal",
    responsible: "Tania Pérez",
    audience: "Instituciones, organizaciones y equipos multidisciplinarios",
  },
];
---

<DashboardLayout title="Contenido social | ForenseIA">
  <section>
    <div class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
        Centro editorial
      </p>

      <h1 class="mt-5 text-4xl font-semibold tracking-[-0.04em] md:text-6xl">
        Contenido social
      </h1>

      <p class="mt-5 max-w-2xl leading-relaxed text-white/45">
        Convierte artículos, cursos, casos y temas especializados en contenido
        adaptable para distintas redes sociales.
      </p>
    </div>
  </section>

  <section class="mt-14">
    <div class="mb-8">
      <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
        Formatos
      </p>

      <h2 class="mt-4 text-3xl font-semibold">
        Elige el tipo de contenido
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {contentTypes.map((item) => (
        <a
          href={item.href}
          class="group flex min-h-[220px] flex-col border border-white/10 bg-white/[0.02] p-7 transition duration-300 hover:-translate-y-1 hover:border-[#C8A96B]/50"
        >
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
              Formato {item.number}
            </span>

            <span class="text-white/20 transition group-hover:text-[#C8A96B]">
              ↗
            </span>
          </div>

          <h3 class="mt-10 text-2xl font-semibold">
            {item.title}
          </h3>

          <p class="mt-4 max-w-xl leading-relaxed text-white/40">
            {item.description}
          </p>

          <p class="mt-auto pt-8 text-sm text-[#C8A96B]">
            Crear contenido →
          </p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-16 border-t border-white/10 pt-14">
    <div class="mb-8">
      <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
        Áreas editoriales
      </p>

      <h2 class="mt-4 text-3xl font-semibold">
        Líneas de contenido
      </h2>
    </div>

    <div class="grid gap-4 xl:grid-cols-3">
      {areas.map((area) => (
        <article class="border border-white/10 bg-white/[0.02] p-6">
          <h3 class="text-xl font-semibold">
            {area.title}
          </h3>

          <p class="mt-3 text-sm text-[#C8A96B]">
            {area.responsible}
          </p>

          <p class="mt-4 text-sm leading-relaxed text-white/40">
            {area.audience}
          </p>
        </article>
      ))}
    </div>
  </section>
</DashboardLayout>