---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import ForenseIAImage from "../../components/ui/ForenseIAImage.astro";
import { getCollection, render } from "astro:content";
import "../../styles/forenseia-assets.css";
import "../../styles/services-academy-pro.css";

export async function getStaticPaths() {
  const services = await getCollection("services");

  return services
    .filter((service) => service.data.status === "published")
    .map((service) => ({
      params: { slug: String(service.id) },
      props: { service },
    }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const searchable = `${service.data.title} ${service.data.area}`.toLowerCase();
const cover = searchable.includes("patrimonial")
  ? "/assets/forenseia/services/servicio-inteligencia-patrimonial-1600.webp"
  : searchable.includes("auditor") || searchable.includes("forense")
    ? "/assets/forenseia/services/servicio-auditoria-forense-1600.webp"
    : "/assets/forenseia/hero/hero-home-centro-operaciones-1600.webp";

const steps = [
  "Definición del requerimiento",
  "Planeación de fuentes y alcance",
  "Obtención y preservación",
  "Validación y correlación",
  "Informe y recomendaciones",
];
---

<BaseLayout title={`${service.data.title} | ForenseIA`} description={service.data.description}>
  <main class="sap-page">
    <article>
      <header class="sap-detail-hero">
        <div class="sap-detail-hero__image">
          <img src={cover} alt="" loading="eager" decoding="async" />
        </div>

        <Container class="sap-detail-hero__container">
          <div class="sap-detail-hero__content">
            <a class="sap-back-link" href="/servicios">← Volver a servicios</a>
            <p class="sap-eyebrow">{service.data.area}</p>
            <h1>{service.data.title}</h1>
            <p>{service.data.description}</p>

            <div class="sap-actions">
              <Button href="/contacto">Solicitar diagnóstico</Button>
              <Button href="#contenido" variant="secondary">Conocer el servicio</Button>
            </div>
          </div>
        </Container>
      </header>

      <section class="sap-detail-summary">
        <Container>
          <div class="sap-summary-grid">
            <article>
              <span>Dirección responsable</span>
              <strong>{service.data.director}</strong>
            </article>
            <article>
              <span>Dirigido a</span>
              <strong>{service.data.audience}</strong>
            </article>
            <article>
              <span>Modalidad</span>
              <strong>Proyecto definido por alcance</strong>
            </article>
          </div>
        </Container>
      </section>

      <section id="contenido" class="sap-detail-content">
        <Container>
          <div class="sap-detail-layout">
            <aside class="sap-detail-aside">
              <div>
                <p class="sap-eyebrow">Proceso</p>
                <ol>
                  {steps.map((step, index) => (
                    <li>
                      <span>0{index + 1}</span>
                      {step}
                    </li>
                  ))}
                </ol>
              </div>
            </aside>

            <div class="sap-editorial">
              <Content />
            </div>
          </div>
        </Container>
      </section>

      <section class="sap-section sap-section--visual">
        <Container>
          <div class="sap-split">
            <ForenseIAImage
              src="/assets/forenseia/services/servicio-auditoria-forense-1600.webp"
              alt="Documentación y análisis dentro de un proceso de investigación."
              class="sap-split__media"
            />
            <div class="sap-split__content">
              <p class="sap-eyebrow">Entregables profesionales</p>
              <h2>Hallazgos organizados para facilitar decisiones.</h2>
              <p>
                El formato final depende del alcance y puede integrar informes, matrices,
                cronologías, mapas de vínculos, fuentes consultadas y recomendaciones.
              </p>
              <Button href="/contacto">Definir alcance</Button>
            </div>
          </div>
        </Container>
      </section>
    </article>
  </main>
</BaseLayout>
