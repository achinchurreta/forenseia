---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const sortedPosts = [...posts].sort(
  (a: any, b: any) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

const categories = [
  ...new Set(sortedPosts.map((post: any) => post.data.category)),
];
---

<BaseLayout
  title="Biblioteca | ForenseIA"
  description="Artículos, análisis y guías sobre inteligencia artificial, investigación digital, ciberseguridad y psicología criminal."
>
  <section class="border-b border-white/10 pt-40 pb-20">
    <Container>
      <div class="grid lg:grid-cols-[0.75fr_1.25fr] gap-12 items-end">
        <div>
          <p class="text-[#C8A96B] uppercase tracking-[0.35em] text-xs">
            Biblioteca ForenseIA
          </p>

          <h1 class="mt-6 text-5xl md:text-7xl font-semibold tracking-[-0.05em] leading-[0.96]">
            Conocimiento para decisiones complejas.
          </h1>
        </div>

        <p class="max-w-2xl text-lg leading-relaxed text-white/50">
          Artículos, análisis, guías y casos sobre inteligencia artificial,
          OSINT, ciberseguridad, investigación digital y psicología criminal.
        </p>
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <div class="flex flex-wrap gap-3">
        <a
          href="/blog"
          class="border border-[#C8A96B]/60 px-4 py-2 text-sm text-[#C8A96B]"
        >
          Todos
        </a>

        {categories.map((category: any) => (
          <span class="border border-white/10 px-4 py-2 text-sm text-white/45">
            {category}
          </span>
        ))}
      </div>
    </Container>
  </section>

  {featuredPost && (
    <section class="pb-20">
      <Container>
        <article class="group grid overflow-hidden border border-white/10 bg-white/[0.02] lg:grid-cols-[1.15fr_0.85fr]">
          <div class="relative min-h-[360px] overflow-hidden bg-black">
            {featuredPost.data.cover ? (
              <img
                src={featuredPost.data.cover}
                alt={featuredPost.data.title}
                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
            ) : (
              <div class="flex h-full min-h-[360px] items-center justify-center bg-[radial-gradient(circle_at_center,rgba(200,169,107,0.14),transparent_55%)]">
                <img
                  src="/logo.png"
                  alt="ForenseIA"
                  class="w-40 opacity-80"
                />
              </div>
            )}
          </div>

          <div class="flex flex-col justify-center p-8 md:p-12">
            <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
              Artículo destacado
            </p>

            <p class="mt-5 text-sm text-white/35">
              {featuredPost.data.category}
            </p>

            <h2 class="mt-4 text-3xl md:text-5xl font-semibold leading-tight">
              {featuredPost.data.title}
            </h2>

            <p class="mt-6 leading-relaxed text-white/50">
              {featuredPost.data.description}
            </p>

            <div class="mt-8">
              <Button href={`/blog/${featuredPost.slug}`}>
                Leer artículo
              </Button>
            </div>
          </div>
        </article>
      </Container>
    </section>
  )}

  <section class="border-t border-white/10 bg-white/[0.02] py-20">
    <Container>
      <div class="mb-12 flex items-end justify-between gap-8">
        <div>
          <p class="text-[#C8A96B] uppercase tracking-[0.3em] text-xs">
            Publicaciones
          </p>

          <h2 class="mt-5 text-4xl md:text-5xl font-semibold">
            Últimos artículos
          </h2>
        </div>

        <p class="hidden text-sm text-white/35 md:block">
          {sortedPosts.length} publicaciones
        </p>
      </div>

      {sortedPosts.length === 0 ? (
        <div class="border border-white/10 bg-black/30 p-10">
          <p class="text-white/50">
            Todavía no hay publicaciones disponibles.
          </p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
          {remainingPosts.map((post: any) => (
            <article class="group flex h-full flex-col overflow-hidden border border-white/10 bg-black/40 transition duration-300 hover:-translate-y-1 hover:border-[#C8A96B]/50">
              <div class="relative aspect-[16/9] overflow-hidden border-b border-white/10">
                {post.data.cover ? (
                  <img
                    src={post.data.cover}
                    alt={post.data.title}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center bg-[radial-gradient(circle_at_center,rgba(200,169,107,0.10),transparent_60%)]">
                    <img
                      src="/logo.png"
                      alt="ForenseIA"
                      class="w-20 opacity-60"
                    />
                  </div>
                )}
              </div>

              <div class="flex flex-1 flex-col p-7">
                <p class="text-xs uppercase tracking-[0.25em] text-[#C8A96B]">
                  {post.data.category}
                </p>

                <h3 class="mt-5 text-2xl font-semibold leading-tight">
                  {post.data.title}
                </h3>

                <p class="mt-4 flex-1 leading-relaxed text-white/45">
                  {post.data.description}
                </p>

                <a
                  href={`/blog/${post.slug}`}
                  class="mt-8 text-sm text-[#C8A96B]"
                >
                  Leer artículo →
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </Container>
  </section>
</BaseLayout>