---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import { getCollection } from "astro:content";
import "../styles/blog.css";

const posts = (await getCollection("blog"))
  .filter((entry) => {
    const data = entry.data as Record<string, any>;
    return data.status !== "draft" && data.draft !== true;
  })
  .sort((a, b) => {
    const aDate = new Date((a.data as Record<string, any>).date ?? 0).getTime();
    const bDate = new Date((b.data as Record<string, any>).date ?? 0).getTime();
    return bDate - aDate;
  });

const featured = posts.find((entry) => (entry.data as Record<string, any>).featured === true) ?? posts[0];
const latestPosts = featured ? posts.filter((entry) => entry.id !== featured.id) : posts;

const formatDate = (value: unknown) => {
  if (!value) return "";
  const date = new Date(String(value));
  if (Number.isNaN(date.getTime())) return String(value);
  return new Intl.DateTimeFormat("es-MX", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
};

const getCover = (value: any): string => {
  if (typeof value === "string") return value.trim();
  if (value && typeof value.src === "string") return value.src;
  return "";
};

const getCategory = (data: Record<string, any>) =>
  data.category ?? data.area ?? "Investigación digital";

const getDescription = (data: Record<string, any>) =>
  data.description ?? data.excerpt ?? "Artículo especializado de ForenseIA.";
---

<BaseLayout
  title="Blog | ForenseIA"
  description="Artículos, análisis y metodologías sobre OSINT, investigación digital, inteligencia artificial aplicada e inteligencia patrimonial."
>
  <main class="fi-blog-page">
    <section class="fi-blog-hero">
      <Container>
        <div class="fi-blog-heading">
          <div>
            <p class="fi-blog-eyebrow">Blog ForenseIA</p>
            <h1>Investigación, inteligencia y tecnología aplicada.</h1>
          </div>
          <p class="fi-blog-summary">
            Artículos, guías y análisis para investigadores, instituciones,
            analistas y profesionales. La Gaceta permanece como una categoría
            editorial dentro del blog.
          </p>
        </div>

        {featured && (() => {
          const data = featured.data as Record<string, any>;
          const cover = getCover(data.cover ?? data.image);
          return (
            <article class="fi-featured-card">
              <a class="fi-featured-media" href={`/blog/${featured.id}`} aria-label={`Leer ${data.title}`}>
                <div class="fi-media-fallback" aria-hidden="true">
                  <span>FORENSEIA</span>
                  <small>INTELIGENCIA APLICADA</small>
                </div>
                {cover && (
                  <img
                    src={cover}
                    alt={data.coverAlt ?? data.title ?? "Portada del artículo"}
                    loading="eager"
                    decoding="async"
                    onerror="this.style.display='none'"
                  />
                )}
              </a>

              <div class="fi-featured-content">
                <p class="fi-featured-label">Artículo destacado</p>
                <div class="fi-post-meta">
                  <span>{getCategory(data)}</span>
                  <time datetime={String(data.date ?? "")}>{formatDate(data.date)}</time>
                </div>
                <h2><a href={`/blog/${featured.id}`}>{data.title}</a></h2>
                <p class="fi-featured-description">{getDescription(data)}</p>
                <a class="fi-primary-link" href={`/blog/${featured.id}`}>
                  Leer artículo <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          );
        })()}
      </Container>
    </section>

    <section class="fi-latest-section">
      <Container>
        <div class="fi-section-header">
          <div>
            <p class="fi-blog-eyebrow">Publicaciones</p>
            <h2>Últimos artículos</h2>
          </div>
          <p>Contenido práctico, editorial y especializado publicado por el equipo de ForenseIA.</p>
        </div>

        {latestPosts.length > 0 ? (
          <div class="fi-post-grid">
            {latestPosts.map((post) => {
              const data = post.data as Record<string, any>;
              const cover = getCover(data.cover ?? data.image);
              return (
                <article class="fi-post-card">
                  <a class="fi-post-media" href={`/blog/${post.id}`} aria-label={`Leer ${data.title}`}>
                    <div class="fi-media-fallback" aria-hidden="true">
                      <span>FORENSEIA</span>
                    </div>
                    {cover && (
                      <img
                        src={cover}
                        alt={data.coverAlt ?? data.title ?? "Portada del artículo"}
                        loading="lazy"
                        decoding="async"
                        onerror="this.style.display='none'"
                      />
                    )}
                  </a>
                  <div class="fi-post-body">
                    <div class="fi-post-meta">
                      <span>{getCategory(data)}</span>
                      <time datetime={String(data.date ?? "")}>{formatDate(data.date)}</time>
                    </div>
                    <h3><a href={`/blog/${post.id}`}>{data.title}</a></h3>
                    <p>{getDescription(data)}</p>
                    <a class="fi-text-link" href={`/blog/${post.id}`}>Leer artículo →</a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : !featured ? (
          <div class="fi-empty-state">
            <p class="fi-blog-eyebrow">Próximamente</p>
            <h2>Estamos preparando nuevas publicaciones.</h2>
          </div>
        ) : null}
      </Container>
    </section>
  </main>
</BaseLayout>
