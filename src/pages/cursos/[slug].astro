---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
import ForenseIAImage from "../../components/ui/ForenseIAImage.astro";
import { getCollection, render } from "astro:content";
import "../../styles/forenseia-assets.css";
import "../../styles/services-academy-pro.css";

export async function getStaticPaths() {
  const courses = await getCollection("courses");

  return courses
    .filter((course) => course.data.status === "published")
    .map((course) => ({
      params: { slug: String(course.id) },
      props: { course },
    }));
}

const { course } = Astro.props;
const { Content } = await render(course);

const searchable = `${course.data.title} ${course.data.area}`.toLowerCase();
const cover = searchable.includes("patrimonial")
  ? "/assets/forenseia/services/servicio-inteligencia-patrimonial-1600.webp"
  : searchable.includes("forense") || searchable.includes("auditor")
    ? "/assets/forenseia/services/servicio-auditoria-forense-1600.webp"
    : "/assets/forenseia/academy/academia-investigacion-digital-1600.webp";
---

<BaseLayout title={`${course.data.title} | ForenseIA`} description={course.data.description}>
  <main class="sap-page">
    <article>
      <header class="sap-detail-hero sap-detail-hero--course">
        <div class="sap-detail-hero__image">
          <img src={cover} alt="" loading="eager" decoding="async" />
        </div>

        <Container class="sap-detail-hero__container">
          <div class="sap-detail-hero__content">
            <a class="sap-back-link" href="/cursos">← Volver a Academia</a>
            <p class="sap-eyebrow">{course.data.area}</p>
            <h1>{course.data.title}</h1>
            <p>{course.data.description}</p>

            <div class="sap-actions">
              <Button href="/contacto">Solicitar información</Button>
              <Button href="#programa" variant="secondary">Ver programa</Button>
            </div>
          </div>
        </Container>
      </header>

      <section class="sap-detail-summary">
        <Container>
          <div class="sap-summary-grid sap-summary-grid--course">
            <article><span>Instructor</span><strong>{course.data.instructor}</strong></article>
            <article><span>Duración</span><strong>{course.data.duration}</strong></article>
            <article><span>Modalidad</span><strong>{course.data.modality}</strong></article>
            <article><span>Nivel</span><strong>{course.data.level}</strong></article>
          </div>
        </Container>
      </section>

      <section id="programa" class="sap-detail-content">
        <Container>
          <div class="sap-detail-layout">
            <aside class="sap-detail-aside">
              <div class="sap-course-enroll">
                <p class="sap-eyebrow">Ficha del programa</p>
                <dl>
                  <div><dt>Dirigido a</dt><dd>{course.data.audience}</dd></div>
                  {course.data.price && <div><dt>Inversión</dt><dd>{course.data.price}</dd></div>}
                </dl>
                <Button href="/contacto">Solicitar información</Button>
              </div>
            </aside>

            <div class="sap-editorial">
              <Content />
            </div>
          </div>
        </Container>
      </section>

      <section class="sap-section sap-section--visual">
        <Container>
          <div class="sap-split sap-split--reverse">
            <ForenseIAImage
              src="/assets/forenseia/hero/hero-home-centro-operaciones-1600.webp"
              alt="Entorno profesional para formación aplicada en investigación e inteligencia."
              class="sap-split__media"
            />
            <div class="sap-split__content">
              <p class="sap-eyebrow">Programa institucional</p>
              <h2>Capacitación ajustada a funciones y nivel técnico.</h2>
              <p>
                Podemos adaptar duración, ejercicios, casos y productos finales para
                equipos operativos, analistas, investigadores o personal directivo.
              </p>
              <Button href="/contacto">Solicitar propuesta</Button>
            </div>
          </div>
        </Container>
      </section>
    </article>
  </main>
</BaseLayout>
