<script is:inline>
  async function verifyDashboardSession() {
    document.documentElement.dataset.authState = "loading";

    try {
      const response = await fetch(
        "/.netlify/functions/auth-check",
        {
          method: "GET",
          credentials: "include",
          cache: "no-store",
        }
      );

      if (!response.ok) {
        sessionStorage.removeItem("forenseia_user");
        window.location.replace("/login");
        return;
      }

      const data = await response.json();

      if (!data.authenticated || !data.user) {
        sessionStorage.removeItem("forenseia_user");
        window.location.replace("/login");
        return;
      }

      window.forenseiaUser = data.user;

      sessionStorage.setItem(
        "forenseia_user",
        JSON.stringify(data.user)
      );

      document.documentElement.dataset.authState = "ready";

      document.dispatchEvent(
        new CustomEvent("forenseia:user-ready", {
          detail: data.user,
        })
      );
    } catch (error) {
      console.error("Dashboard session error:", error);

      sessionStorage.removeItem("forenseia_user");
      window.location.replace("/login");
    }
  }

  verifyDashboardSession();
</script>