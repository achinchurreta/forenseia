---
import { navigation } from "../../data/navigation";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-container header-inner">
    <a href="/" class="brand" aria-label="ForenseIA, inicio">
      <span class="brand-mark">
        <img src="/logo.png" alt="" />
      </span>

      <span class="brand-copy">
        <strong>FORENSEIA</strong>
        <small>Inteligencia estratégica</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {navigation.map((item) => {
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);

        return (
          <a href={item.href} class:list={["nav-link", { active: isActive }]}> 
            {item.label}
          </a>
        );
      })}
    </nav>

    <a href="/contacto" class="header-cta">
      Solicitar diagnóstico
      <span aria-hidden="true">→</span>
    </a>

    <button
      id="menu-button"
      class="menu-button"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav class="site-container mobile-nav" aria-label="Navegación móvil">
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}

      <a href="/contacto" class="mobile-cta">Solicitar diagnóstico →</a>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    if (!(menu instanceof HTMLElement)) return;

    const willOpen = menu.hasAttribute("hidden");
    menu.toggleAttribute("hidden");
    button.setAttribute("aria-expanded", String(willOpen));
    document.body.classList.toggle("menu-open", willOpen);
  });
</script>
