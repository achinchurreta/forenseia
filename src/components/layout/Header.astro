---
const navigation = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/servicios" },
  { label: "Academia", href: "/cursos" },
  { label: "Biblioteca", href: "/recursos" },
  { label: "Blog", href: "/blog" },
  { label: "Nosotros", href: "/nosotros" },
  { label: "Contacto", href: "/contacto" },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-white/8 bg-[#030303]/90 backdrop-blur-xl">
  <div class="mx-auto flex h-[78px] max-w-[1480px] items-center justify-between gap-8 px-5 sm:px-7 lg:px-10">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label="ForenseIA, inicio">
      <span class="relative flex h-12 w-12 shrink-0 items-center justify-center">
        <span class="absolute inset-1 rounded-full bg-[#d5ad52]/18 blur-lg transition group-hover:bg-[#d5ad52]/28"></span>
        <img
          src="/logo.png"
          alt="Logotipo de ForenseIA"
          class="relative h-11 w-11 object-contain drop-shadow-[0_0_12px_rgba(213,173,82,.3)]"
        />
      </span>

      <span class="hidden min-w-0 sm:block">
        <strong class="block truncate text-sm font-semibold tracking-[0.18em] text-white md:text-base">
          FORENSEIA
        </strong>
        <span class="mt-1 block truncate text-[8px] uppercase tracking-[0.34em] text-[#d5ad52] md:text-[9px]">
          Inteligencia estratégica
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 xl:flex" aria-label="Navegación principal">
      {navigation.map((item) => (
        <a
          href={item.href}
          class="relative py-2 text-sm font-medium text-white/66 transition hover:text-white after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-[#d5ad52] after:transition-transform hover:after:scale-x-100"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contacto"
        class="hidden min-h-11 items-center border border-[#d5ad52]/55 px-5 text-sm font-semibold text-[#e8ce84] transition hover:border-[#d5ad52] hover:bg-[#d5ad52]/8 lg:inline-flex"
      >
        Solicitar diagnóstico
      </a>

      <button
        id="menu-button"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center border border-white/12 text-white xl:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="sr-only">Abrir menú</span>
        <span aria-hidden="true" class="text-xl">☰</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/8 bg-[#050505] px-5 py-6 xl:hidden">
    <nav class="mx-auto flex max-w-[1480px] flex-col" aria-label="Navegación móvil">
      {navigation.map((item) => (
        <a href={item.href} class="border-b border-white/8 py-4 text-sm text-white/72 hover:text-[#d5ad52]">
          {item.label}
        </a>
      ))}
      <a href="/contacto" class="mt-5 bg-[#d5ad52] px-5 py-4 text-center text-sm font-semibold text-black">
        Solicitar diagnóstico
      </a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById("menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  menuButton?.addEventListener("click", () => {
    const isOpen = !mobileMenu?.classList.contains("hidden");
    mobileMenu?.classList.toggle("hidden");
    menuButton.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
