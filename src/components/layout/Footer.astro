---
import { CONTACT } from "../../constants/contact";
---

<footer class="border-t border-white/10 bg-black py-16">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-10">
      <div class="max-w-md">
        <div class="flex items-center gap-4">
          <img
            src="/logo.png"
            alt="ForenseIA"
            class="w-11 h-11 object-contain"
          />

          <div>
            <h3 class="text-white font-semibold tracking-wide">
              FORENSEIA
            </h3>

            <p class="text-[#C8A96B] text-[10px] uppercase tracking-[0.3em]">
              Inteligencia aplicada
            </p>
          </div>
        </div>

        <p class="mt-6 text-white/45 leading-relaxed">
          Tecnología, inteligencia y conocimiento para resolver problemas complejos.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-10 text-sm">
        <div>
          <h4 class="text-white mb-4">Sitio</h4>

          <div class="space-y-3 text-white/45">
            <a href="/servicios" class="block hover:text-[#C8A96B]">Servicios</a>
            <a href="/cursos" class="block hover:text-[#C8A96B]">Cursos</a>
            <a href="/blog" class="block hover:text-[#C8A96B]">Blog</a>
            <a href="/nosotros" class="block hover:text-[#C8A96B]">Nosotros</a>
          </div>
        </div>

        <div>
          <h4 class="text-white mb-4">Contacto</h4>

          <div class="space-y-3 text-white/45">
            <a href={CONTACT.whatsapp} target="_blank" class="block hover:text-[#C8A96B]">
              WhatsApp
            </a>

            <a href={`mailto:${CONTACT.email}`} class="block hover:text-[#C8A96B]">
              Correo
            </a>

            <a href="/contacto" class="block hover:text-[#C8A96B]">
              Diagnóstico
            </a>
          </div>
        </div>

        <div>
          <h4 class="text-white mb-4">Redes</h4>

          <div class="space-y-3 text-white/45">
            <a href={CONTACT.facebook} target="_blank" class="block hover:text-[#C8A96B]">
              Facebook
            </a>

            <a href={CONTACT.instagram} target="_blank" class="block hover:text-[#C8A96B]">
              Instagram
            </a>

            <a href={CONTACT.tiktok} target="_blank" class="block hover:text-[#C8A96B]">
              TikTok
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-6 flex flex-col md:flex-row justify-between gap-4 text-xs text-white/30">
      <p>© 2026 ForenseIA.</p>
      <p>IA · Investigación Digital · Ciberseguridad</p>
    </div>
  </div>
</footer>