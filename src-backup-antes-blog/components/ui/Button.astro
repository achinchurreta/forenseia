---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "text";
  class?: string;
}

const {
  href,
  variant = "primary",
  class: className = "",
} = Astro.props;

const styles = {
  primary:
    "border border-[#d5ad52] bg-[#d5ad52] text-black shadow-[0_10px_35px_rgba(213,173,82,.16)] hover:-translate-y-0.5 hover:bg-[#e2bf69]",
  secondary:
    "border border-[#d5ad52]/55 bg-black/20 text-[#ead28d] hover:-translate-y-0.5 hover:border-[#d5ad52] hover:bg-[#d5ad52]/8",
  text:
    "text-[#d5ad52] hover:text-[#f0d98e]",
};
---

<a
  href={href}
  class={`inline-flex min-h-12 items-center justify-center gap-3 px-6 py-3 text-sm font-semibold transition duration-300 ${styles[variant]} ${className}`}
>
  <slot />
</a>
