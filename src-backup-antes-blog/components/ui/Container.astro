---
interface Props {
  class?: string;
  size?: "wide" | "default" | "editorial";
}

const {
  class: className = "",
  size = "default",
} = Astro.props;

const sizes = {
  wide: "max-w-[1480px]",
  default: "max-w-[1280px]",
  editorial: "max-w-[860px]",
};
---

<div class={`mx-auto w-full px-5 sm:px-7 lg:px-10 ${sizes[size]} ${className}`}>
  <slot />
</div>
