---
const columns = [
  {
    title: "Explorar",
    links: [
      ["Servicios", "/servicios"],
      ["Academia", "/cursos"],
      ["Biblioteca", "/recursos"],
      ["Gaceta", "/blog"],
    ],
  },
  {
    title: "Especialidades",
    links: [
      ["OSINT", "/servicios"],
      ["Investigación digital", "/servicios"],
      ["IA aplicada", "/servicios"],
      ["Inteligencia patrimonial", "/servicios"],
    ],
  },
  {
    title: "Institucional",
    links: [
      ["Nosotros", "/nosotros"],
      ["Contacto", "/contacto"],
      ["Aviso de privacidad", "/privacidad"],
    ],
  },
];
---

<footer class="border-t border-white/8 bg-[#030303] py-16">
  <div class="mx-auto max-w-[1280px] px-5 sm:px-7 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_1.45fr]">
      <div class="max-w-md">
        <div class="flex items-center gap-4">
          <img src="/logo.png" alt="ForenseIA" class="h-12 w-12 object-contain drop-shadow-[0_0_12px_rgba(213,173,82,.22)]" />
          <div>
            <p class="font-semibold tracking-[0.18em]">FORENSEIA</p>
            <p class="mt-1 text-[9px] uppercase tracking-[0.32em] text-[#d5ad52]">Inteligencia estratégica</p>
          </div>
        </div>
        <p class="mt-6 text-sm leading-7 text-white/46">
          Formación, investigación y soluciones especializadas para convertir información compleja en decisiones sustentadas.
        </p>
      </div>

      <div class="grid gap-9 sm:grid-cols-3">
        {columns.map((column) => (
          <div>
            <h2 class="text-xs uppercase tracking-[0.24em] text-white/82">{column.title}</h2>
            <div class="mt-5 space-y-3">
              {column.links.map(([label, href]) => (
                <a href={href} class="block text-sm text-white/42 transition hover:text-[#d5ad52]">{label}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-white/8 pt-6 text-xs text-white/28 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 ForenseIA. Todos los derechos reservados.</p>
      <p>OSINT · Investigación digital · IA aplicada · Inteligencia patrimonial</p>
    </div>
  </div>
</footer>
