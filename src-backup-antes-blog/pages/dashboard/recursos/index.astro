---
import DashboardLayout from "../../../components/dashboard/DashboardLayout.astro";
import { getCollection } from "astro:content";

const resources = (await getCollection("resources")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) {
    return Number(b.data.featured) - Number(a.data.featured);
  }

  if (a.data.order !== b.data.order) {
    return a.data.order - b.data.order;
  }

  return (
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
  );
});

const publishedResources = resources.filter(
  (resource) => resource.data.status === "published"
);

const draftResources = resources.filter(
  (resource) => resource.data.status === "draft"
);

const leadResources = resources.filter(
  (resource) => resource.data.requiresLead
);

function formatDate(date: Date | string) {
  return new Intl.DateTimeFormat("es-MX", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(new Date(date));
}
---

<DashboardLayout title="Recursos | ForenseIA">
  <section>
    <div class="flex flex-col justify-between gap-8 xl:flex-row xl:items-end">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
          Recursos
        </p>

        <h1 class="mt-5 text-4xl font-semibold tracking-[-0.04em] md:text-6xl">
          Recursos descargables
        </h1>

        <p class="mt-5 max-w-2xl leading-relaxed text-white/45">
          Crea y administra guías, checklists, plantillas, ebooks y otros
          materiales para aportar valor y captar prospectos.
        </p>

        <p
          id="content-filter-notice"
          class="mt-5 hidden text-sm text-[#C8A96B]"
        ></p>
      </div>

      <a
        href="/dashboard/recursos/new"
        class="inline-flex w-fit bg-[#C8A96B] px-6 py-4 font-medium text-black transition hover:opacity-90"
      >
        Nuevo recurso
      </a>
    </div>
  </section>

  <section class="mt-12 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <article class="border border-white/10 bg-white/[0.02] p-6">
      <p
        id="visible-content-count"
        class="text-4xl font-semibold text-[#C8A96B]"
      >
        {resources.length}
      </p>

      <p class="mt-4 text-white/45">
        Recursos visibles
      </p>
    </article>

    <article class="border border-white/10 bg-white/[0.02] p-6">
      <p
        id="visible-published-count"
        class="text-4xl font-semibold text-[#C8A96B]"
      >
        {publishedResources.length}
      </p>

      <p class="mt-4 text-white/45">
        Publicados
      </p>
    </article>

    <article class="border border-white/10 bg-white/[0.02] p-6">
      <p
        id="visible-drafts-count"
        class="text-4xl font-semibold text-[#C8A96B]"
      >
        {draftResources.length}
      </p>

      <p class="mt-4 text-white/45">
        Borradores
      </p>
    </article>

    <article class="border border-white/10 bg-white/[0.02] p-6">
      <p
        id="visible-leads-count"
        class="text-4xl font-semibold text-[#C8A96B]"
      >
        {leadResources.length}
      </p>

      <p class="mt-4 text-white/45">
        Capturan prospectos
      </p>
    </article>
  </section>

  <section class="mt-12">
    {resources.length === 0 ? (
      <div class="border border-white/10 bg-white/[0.02] p-8">
        <p class="text-white/45">
          Todavía no hay recursos creados.
        </p>

        <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/30">
          Puedes comenzar con una guía, checklist, plantilla o ebook relacionado
          con alguno de los servicios de tu dirección.
        </p>

        <a
          href="/dashboard/recursos/new"
          class="mt-6 inline-flex bg-[#C8A96B] px-5 py-3 text-sm font-medium text-black transition hover:opacity-90"
        >
          Crear primer recurso
        </a>
      </div>
    ) : (
      <>
        <div id="content-list" class="space-y-4">
          {resources.map((resource) => (
            <article
              data-content-card
              data-content-owner={resource.data.author}
              data-content-status={resource.data.status}
              data-requires-lead={String(resource.data.requiresLead)}
              class="flex flex-col justify-between gap-7 border border-white/10 bg-white/[0.02] p-6 transition duration-300 hover:border-[#C8A96B]/40 xl:flex-row xl:items-center"
            >
              <div class="max-w-3xl">
                <div class="flex flex-wrap items-center gap-3 text-xs">
                  <span class="uppercase tracking-[0.22em] text-[#C8A96B]">
                    {resource.data.type}
                  </span>

                  <span class="text-white/30">
                    {resource.data.area}
                  </span>

                  <span
                    class:list={[
                      "border px-3 py-1",
                      resource.data.status === "published"
                        ? "border-emerald-400/20 text-emerald-300"
                        : "border-amber-400/20 text-amber-300",
                    ]}
                  >
                    {resource.data.status === "published"
                      ? "Publicado"
                      : "Borrador"}
                  </span>

                  {resource.data.featured && (
                    <span class="border border-[#C8A96B]/20 px-3 py-1 text-[#C8A96B]">
                      Destacado
                    </span>
                  )}

                  {resource.data.requiresLead && (
                    <span class="border border-sky-400/20 px-3 py-1 text-sky-300">
                      Captura prospectos
                    </span>
                  )}

                  <span class="text-white/25">
                    Orden: {resource.data.order}
                  </span>
                </div>

                <h2 class="mt-4 text-2xl font-semibold">
                  {resource.data.title}
                </h2>

                <p class="mt-3 leading-relaxed text-white/45">
                  {resource.data.description}
                </p>

                <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/30">
                  <span>
                    Autor: {resource.data.author}
                  </span>

                  <span>
                    Público: {resource.data.audience}
                  </span>

                  <span>
                    {formatDate(resource.data.date)}
                  </span>
                </div>

                <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-white/25">
                  {resource.data.fileFormat && (
                    <span>
                      Formato: {resource.data.fileFormat}
                    </span>
                  )}

                  {resource.data.fileSize && (
                    <span>
                      Tamaño: {resource.data.fileSize}
                    </span>
                  )}

                  {resource.data.campaign && (
                    <span>
                      Campaña: {resource.data.campaign}
                    </span>
                  )}
                </div>
              </div>

              <div class="flex flex-wrap gap-3">
                {resource.data.status === "published" && (
                  <a
                    href={`/recursos/${resource.id}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="border border-white/10 px-5 py-3 text-sm text-white/55 transition hover:border-[#C8A96B]/60 hover:text-[#C8A96B]"
                  >
                    Ver
                  </a>
                )}

                <a
                  href={resource.data.downloadUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border border-white/10 px-5 py-3 text-sm text-white/55 transition hover:border-[#C8A96B]/60 hover:text-[#C8A96B]"
                >
                  Archivo
                </a>

                <a
                  href={`/dashboard/recursos/edit/${resource.id}`}
                  data-edit-link
                  class="border border-white/10 px-5 py-3 text-sm text-white/55 transition hover:border-[#C8A96B]/60 hover:text-[#C8A96B]"
                >
                  Editar
                </a>

                <button
                  type="button"
                  data-delete-resource
                  data-slug={resource.id}
                  data-title={resource.data.title}
                  data-owner={resource.data.author}
                  class="border border-red-400/20 px-5 py-3 text-sm text-red-300/70 transition hover:bg-red-500/10 hover:text-red-300 disabled:cursor-not-allowed disabled:opacity-50"
                >
                  Eliminar
                </button>
              </div>
            </article>
          ))}
        </div>

        <div
          id="no-visible-content"
          class="hidden border border-white/10 bg-white/[0.02] p-8"
        >
          <p class="text-white/45">
            Todavía no tienes recursos creados dentro de tu dirección.
          </p>

          <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/30">
            Crea un material gratuito que pueda utilizarse desde artículos,
            publicaciones en redes sociales o campañas de captación.
          </p>

          <a
            href="/dashboard/recursos/new"
            class="mt-6 inline-flex bg-[#C8A96B] px-5 py-3 text-sm font-medium text-black transition hover:opacity-90"
          >
            Crear recurso
          </a>
        </div>
      </>
    )}
  </section>

  <section class="mt-16 border-t border-white/10 pt-12">
    <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <article class="border border-white/10 bg-white/[0.02] p-7">
        <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
          Embudo de ventas
        </p>

        <h2 class="mt-5 text-2xl font-semibold">
          Convierte conocimiento en oportunidades
        </h2>

        <p class="mt-4 max-w-2xl leading-relaxed text-white/40">
          Cada recurso debe estar relacionado con un artículo, curso o servicio
          y conducir al visitante hacia una acción comercial.
        </p>

        <div class="mt-8 grid gap-3 text-sm text-white/45">
          <div class="border border-white/10 px-5 py-4">
            01. Publicación o artículo
          </div>

          <div class="border border-white/10 px-5 py-4">
            02. Recurso descargable
          </div>

          <div class="border border-white/10 px-5 py-4">
            03. Captura de datos
          </div>

          <div class="border border-white/10 px-5 py-4">
            04. Seguimiento y diagnóstico
          </div>

          <div class="border border-white/10 px-5 py-4">
            05. Curso o servicio
          </div>
        </div>
      </article>

      <article class="border border-white/10 bg-white/[0.02] p-7">
        <p class="text-xs uppercase tracking-[0.3em] text-[#C8A96B]">
          Próximo módulo
        </p>

        <h2 class="mt-5 text-2xl font-semibold">
          Prospectos
        </h2>

        <p class="mt-4 leading-relaxed text-white/40">
          Los recursos que soliciten datos se conectarán con un módulo donde
          podremos consultar nombre, correo, institución, área de interés,
          campaña y fecha de registro.
        </p>

        <div class="mt-8 border border-white/10 bg-black p-5">
          <p class="text-sm text-white/35">
            Estado
          </p>

          <p class="mt-2 text-[#C8A96B]">
            Pendiente de implementación
          </p>
        </div>
      </article>
    </div>
  </section>

  <p
    id="delete-message"
    class="mt-6 min-h-6 text-sm text-white/45"
  ></p>

  <script is:inline>
    const contentCards = Array.from(
      document.querySelectorAll("[data-content-card]")
    );

    const deleteButtons = document.querySelectorAll(
      "[data-delete-resource]"
    );

    const message = document.getElementById(
      "delete-message"
    );

    const filterNotice = document.getElementById(
      "content-filter-notice"
    );

    const noVisibleContent = document.getElementById(
      "no-visible-content"
    );

    const visibleCount = document.getElementById(
      "visible-content-count"
    );

    const visiblePublishedCount = document.getElementById(
      "visible-published-count"
    );

    const visibleDraftsCount = document.getElementById(
      "visible-drafts-count"
    );

    const visibleLeadsCount = document.getElementById(
      "visible-leads-count"
    );

    let currentUser = null;

    function getAllowedOwner(user) {
      if (user.role === "director-ia") {
        return "Gonzalo García";
      }

      if (user.role === "director-psychology") {
        return "Tania Pérez";
      }

      return null;
    }

    function canManageOwner(user, owner) {
      if (!user) {
        return false;
      }

      if (user.role === "admin") {
        return true;
      }

      return getAllowedOwner(user) === owner;
    }

    function getVisibleCards() {
      return Array.from(
        document.querySelectorAll(
          "[data-content-card]:not(.hidden)"
        )
      );
    }

    function updateCounters(visibleCards) {
      const published = visibleCards.filter(
        (card) =>
          card.dataset.contentStatus === "published"
      );

      const drafts = visibleCards.filter(
        (card) =>
          card.dataset.contentStatus === "draft"
      );

      const leads = visibleCards.filter(
        (card) =>
          card.dataset.requiresLead === "true"
      );

      if (visibleCount) {
        visibleCount.textContent = String(
          visibleCards.length
        );
      }

      if (visiblePublishedCount) {
        visiblePublishedCount.textContent = String(
          published.length
        );
      }

      if (visibleDraftsCount) {
        visibleDraftsCount.textContent = String(
          drafts.length
        );
      }

      if (visibleLeadsCount) {
        visibleLeadsCount.textContent = String(
          leads.length
        );
      }

      if (noVisibleContent) {
        noVisibleContent.classList.toggle(
          "hidden",
          visibleCards.length > 0
        );
      }
    }

    function applyContentFilter(user) {
      currentUser = user;

      const allowedOwner = getAllowedOwner(user);
      const visibleCards = [];

      contentCards.forEach((card) => {
        const owner =
          card.dataset.contentOwner || "";

        const visible =
          user.role === "admin" ||
          owner === allowedOwner;

        card.classList.toggle(
          "hidden",
          !visible
        );

        if (visible) {
          visibleCards.push(card);
        }

        card
          .querySelectorAll(
            "[data-edit-link], [data-delete-resource]"
          )
          .forEach((control) => {
            control.classList.toggle(
              "hidden",
              !canManageOwner(user, owner)
            );
          });
      });

      updateCounters(visibleCards);

      if (!filterNotice) {
        return;
      }

      if (user.role === "admin") {
        filterNotice.textContent = "";
        filterNotice.classList.add("hidden");
        return;
      }

      filterNotice.textContent =
        `Mostrando únicamente recursos de ${allowedOwner}.`;

      filterNotice.classList.remove("hidden");
    }

    try {
      const storedUser = JSON.parse(
        sessionStorage.getItem(
          "forenseia_user"
        ) || "null"
      );

      if (storedUser) {
        applyContentFilter(storedUser);
      }
    } catch (error) {
      console.error(
        "No se pudo leer el usuario almacenado:",
        error
      );

      sessionStorage.removeItem(
        "forenseia_user"
      );
    }

    document.addEventListener(
      "forenseia:user-ready",
      (event) => {
        applyContentFilter(event.detail);
      }
    );

    deleteButtons.forEach((button) => {
      button.addEventListener(
        "click",
        async () => {
          const slug = button.dataset.slug;
          const title = button.dataset.title;
          const owner = button.dataset.owner;

          if (
            !slug ||
            !currentUser
          ) {
            return;
          }

          if (
            !canManageOwner(
              currentUser,
              owner
            )
          ) {
            if (message) {
              message.textContent =
                "No tienes permiso para eliminar este recurso.";
            }

            return;
          }

          const confirmed =
            window.confirm(
              `¿Seguro que deseas eliminar el recurso "${title}"?`
            );

          if (!confirmed) {
            return;
          }

          button.disabled = true;
          button.textContent =
            "Eliminando...";

          if (message) {
            message.textContent =
              "Eliminando recurso...";
          }

          try {
            const response = await fetch(
              "/.netlify/functions/delete-resource",
              {
                method: "POST",
                credentials: "include",
                headers: {
                  "Content-Type":
                    "application/json",
                },
                body: JSON.stringify({
                  slug,
                }),
              }
            );

            const text =
              await response.text();

            let data = {};

            try {
              data = text
                ? JSON.parse(text)
                : {};
            } catch {
              throw new Error(
                text ||
                  "La función devolvió una respuesta inválida"
              );
            }

            if (!response.ok) {
              throw new Error(
                data.error ||
                  "No se pudo eliminar el recurso"
              );
            }

            const card = button.closest(
              "[data-content-card]"
            );

            card?.remove();

            updateCounters(
              getVisibleCards()
            );

            if (message) {
              message.textContent =
                "Recurso eliminado. Netlify iniciará un nuevo despliegue.";
            }
          } catch (error) {
            if (message) {
              message.textContent =
                error instanceof Error
                  ? `Error: ${error.message}`
                  : "No se pudo eliminar el recurso.";
            }

            button.disabled = false;
            button.textContent =
              "Eliminar";
          }
        }
      );
    });
  </script>
</DashboardLayout>