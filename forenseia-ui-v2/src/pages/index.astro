---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import Button from "../components/ui/Button.astro";
import Reveal from "../components/ui/Reveal.astro";
import { getCollection } from "astro:content";
import { services } from "../data/services";
import { courses } from "../data/courses";

const posts = (await getCollection("blog"))
  .filter((post) => post.data.status === "published")
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const latestPosts = posts.slice(0, 3);

const areas = [
  {
    number: "01",
    title: "Investigación digital y OSINT",
    description: "Metodologías, capacitación y apoyo técnico para localizar, validar, relacionar y documentar información de fuentes abiertas.",
    href: "/servicios",
  },
  {
    number: "02",
    title: "Inteligencia artificial aplicada",
    description: "Automatización, análisis de información y soluciones de IA diseñadas para procesos institucionales y estratégicos.",
    href: "/servicios",
  },
  {
    number: "03",
    title: "Psicología criminal",
    description: "Formación y análisis especializado en conducta, prevención, perfiles y contextos de investigación.",
    href: "/servicios",
  },
];
---

<BaseLayout
  title="ForenseIA | Inteligencia aplicada para instituciones"
  description="OSINT, investigación digital, inteligencia artificial y psicología criminal aplicada para fiscalías, gobierno, seguridad pública y organizaciones."
>
  <section class="relative overflow-hidden border-b border-white/10">
    <div class="site-grid pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute right-[-18rem] top-[-16rem] h-[48rem] w-[48rem] rounded-full bg-[#C8A96B]/10 blur-[170px]"></div>

    <Container class="relative py-20 sm:py-28 lg:py-36">
      <div class="grid items-end gap-14 lg:grid-cols-[minmax(0,1fr)_360px] xl:gap-24">
        <Reveal>
          <div class="max-w-5xl">
            <p class="eyebrow">Inteligencia aplicada</p>
            <h1 class="mt-7 text-[clamp(3.25rem,8vw,7.5rem)] font-semibold leading-[0.88] tracking-[-0.072em]">
              Decisiones complejas necesitan evidencia clara.
            </h1>
            <p class="mt-8 max-w-2xl text-base leading-8 text-white/58 sm:text-lg lg:text-xl">
              Integramos OSINT, investigación digital, inteligencia artificial y psicología criminal para fortalecer capacidades institucionales.
            </p>
            <div class="mt-10 flex flex-wrap gap-3">
              <Button href="/contacto">Solicitar diagnóstico</Button>
              <Button href="/cursos" variant="secondary">Explorar cursos</Button>
            </div>
          </div>
        </Reveal>

        <Reveal delay={120}>
          <aside class="panel p-6 sm:p-7">
            <div class="flex items-center justify-between border-b border-white/10 pb-5">
              <span class="text-[10px] font-semibold uppercase tracking-[0.24em] text-white/35">Enfoque institucional</span>
              <span class="h-2 w-2 rounded-full bg-[#C8A96B] shadow-[0_0_18px_rgba(200,169,107,0.7)]"></span>
            </div>
            <div class="space-y-5 py-6 text-sm">
              <div><p class="text-white/30">Especialidades</p><p class="mt-1 text-white/80">OSINT · IA · Psicología</p></div>
              <div><p class="text-white/30">Aplicación</p><p class="mt-1 text-white/80">Investigación y toma de decisiones</p></div>
              <div><p class="text-white/30">Público</p><p class="mt-1 text-white/80">Fiscalías, gobierno e instituciones</p></div>
            </div>
            <div class="rule"></div>
            <p class="mt-5 text-xs leading-6 text-white/36">Formación, consultoría y contenidos diseñados para aplicación profesional.</p>
          </aside>
        </Reveal>
      </div>
    </Container>
  </section>

  <section class="border-b border-white/10 py-20 sm:py-24 lg:py-28">
    <Container>
      <Reveal>
        <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
          <div>
            <p class="eyebrow">Áreas de especialización</p>
            <h2 class="section-title mt-5">Una sola plataforma. Tres disciplinas conectadas.</h2>
          </div>
          <p class="section-copy lg:pt-9">
            Trabajamos con una visión multidisciplinaria para convertir información dispersa en conocimiento útil, documentado y aplicable.
          </p>
        </div>
      </Reveal>

      <div class="mt-14 grid border-l border-t border-white/10 md:grid-cols-3">
        {areas.map((area, index) => (
          <Reveal delay={index * 90}>
            <a href={area.href} class="group flex min-h-[330px] flex-col border-b border-r border-white/10 p-7 transition duration-300 hover:bg-white/[0.035] sm:p-9">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold tracking-[0.2em] text-[#C8A96B]">{area.number}</span>
                <span class="text-white/20 transition group-hover:translate-x-1 group-hover:text-[#C8A96B]">→</span>
              </div>
              <h3 class="mt-auto text-2xl font-semibold leading-tight tracking-[-0.035em] sm:text-3xl">{area.title}</h3>
              <p class="mt-5 text-sm leading-7 text-white/45">{area.description}</p>
            </a>
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  <section class="border-b border-white/10 bg-white/[0.018] py-20 sm:py-24 lg:py-28">
    <Container>
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <Reveal>
          <div>
            <p class="eyebrow">Servicios</p>
            <h2 class="section-title mt-5">Soluciones especializadas, no paquetes genéricos.</h2>
          </div>
        </Reveal>
        <Button href="/servicios" variant="secondary">Ver todos</Button>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {services.slice(0, 3).map((service, index) => (
          <Reveal delay={index * 90}>
            <ServiceCard title={service.title} description={service.description} href={service.href} label="Ver servicio" />
          </Reveal>
        ))}
      </div>
    </Container>
  </section>

  <section class="border-b border-white/10 py-20 sm:py-24 lg:py-28">
    <Container>
      <div class="grid gap-14 lg:grid-cols-[0.72fr_1.28fr]">
        <Reveal>
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="eyebrow">Formación</p>
            <h2 class="section-title mt-5">Cursos creados para comprender y aplicar.</h2>
            <p class="section-copy mt-6">Programas prácticos para equipos, instituciones y profesionales que necesitan metodología, no solo herramientas.</p>
            <div class="mt-8"><Button href="/cursos" variant="secondary">Ver cursos</Button></div>
          </div>
        </Reveal>

        <div class="grid gap-5 sm:grid-cols-2">
          {courses.slice(0, 4).map((course, index) => (
            <Reveal delay={index * 80}>
              <ServiceCard title={course.title} description={`${course.duration} · ${course.modality}`} href={course.href} label="Ver programa" />
            </Reveal>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="border-b border-white/10 bg-white/[0.018] py-20 sm:py-24 lg:py-28">
    <Container>
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <Reveal>
          <div>
            <p class="eyebrow">Biblioteca</p>
            <h2 class="section-title mt-5">Análisis para investigar mejor.</h2>
          </div>
        </Reveal>
        <Button href="/blog" variant="secondary">Explorar artículos</Button>
      </div>

      {latestPosts.length === 0 ? (
        <div class="panel mt-12 p-8 text-white/50">Próximamente publicaremos artículos especializados.</div>
      ) : (
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {latestPosts.map((post, index) => (
            <Reveal delay={index * 90}>
              <ServiceCard title={post.data.title} description={post.data.description} href={`/blog/${post.id}`} label="Leer artículo" />
            </Reveal>
          ))}
        </div>
      )}
    </Container>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[30rem] w-[30rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#C8A96B]/8 blur-[150px]"></div>
    <Container class="relative">
      <Reveal>
        <div class="mx-auto max-w-4xl text-center">
          <p class="eyebrow">Contacto institucional</p>
          <h2 class="mt-6 text-4xl font-semibold leading-[0.98] tracking-[-0.055em] sm:text-6xl lg:text-7xl">Conversemos sobre el problema antes de hablar de la solución.</h2>
          <p class="mx-auto mt-7 max-w-2xl text-base leading-8 text-white/50 sm:text-lg">Explícanos el contexto y conectaremos tu necesidad con el área especializada adecuada.</p>
          <div class="mt-10"><Button href="/contacto">Solicitar diagnóstico</Button></div>
        </div>
      </Reveal>
    </Container>
  </section>
</BaseLayout>
