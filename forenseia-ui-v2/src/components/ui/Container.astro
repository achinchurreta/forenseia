---
interface Props {
  class?: string;
  size?: "default" | "wide" | "narrow";
}

const {
  class: className = "",
  size = "default",
} = Astro.props;

const widths = {
  default: "max-w-[1280px]",
  wide: "max-w-[1440px]",
  narrow: "max-w-[920px]",
};
---

<div class={`mx-auto w-full ${widths[size]} px-5 sm:px-7 lg:px-10 ${className}`}>
  <slot />
</div>
